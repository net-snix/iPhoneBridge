#import <Foundation/Foundation.h>
#import <dispatch/dispatch.h>
#include <cassert>
#include <cmath>
#include <iostream>
#include "CaptureSchedule.h"

static NSMutableArray *handlers;
static int created = 0, cancelled = 0, configured = 0;

static dispatch_source_t recordCreate(dispatch_source_type_t type, uintptr_t handle,
                                      uintptr_t mask, dispatch_queue_t queue) {
    assert([NSThread isMainThread]);
    assert(type == DISPATCH_SOURCE_TYPE_TIMER && handle == 0 && mask == DISPATCH_TIMER_STRICT);
    assert(queue == dispatch_get_main_queue());
    ++created;
    return dispatch_source_create(type, handle, mask, queue);
}

static void recordHandler(dispatch_source_t source, dispatch_block_t handler) {
    [handlers addObject:[handler copy]]; // Retain callbacks to expose accidental owner cycles.
    dispatch_source_set_event_handler(source, handler);
}

static void recordTimer(dispatch_source_t source, dispatch_time_t start,
                        uint64_t interval, uint64_t leeway) {
    assert(interval == DISPATCH_TIME_FOREVER && leeway == 0);
    ++configured;
    dispatch_source_set_timer(source, start, interval, leeway);
}

static void recordCancel(dispatch_source_t source) {
    assert(!dispatch_source_testcancel(source)); // Exactly one cancellation for each source.
    ++cancelled;
    dispatch_source_cancel(source);
}

#define dispatch_source_create recordCreate
#define dispatch_source_set_event_handler recordHandler
#define dispatch_source_set_timer recordTimer
#define dispatch_source_cancel recordCancel

@interface ScreenCapturer : NSObject {
@public
    TVCaptureSchedule mCaptureSchedule;
    dispatch_source_t mCaptureWakeTimer;
    uint64_t mCaptureWakeTimerSerial;
    int attempts;
    BOOL rearmOnAttempt;
}
- (void)queueCaptureWake:(uint64_t)generation after:(double)delay;
- (void)cancelCaptureWakeTimer;
- (void)attemptCapture;
- (void)request:(double)delay;
- (void)stop;
@end

@implementation ScreenCapturer
- (instancetype)init {
    self = [super init];
    if (self) mCaptureSchedule.start(60);
    return self;
}

- (void)request:(double)delay {
    uint64_t generation = mCaptureSchedule.request();
    [self queueCaptureWake:generation after:delay];
}

- (void)stop {
    // Copied verbatim from production endCapture's main-queue stop block.
    /* STOP_BODY */
}

- (void)attemptCapture {
    assert([NSThread isMainThread]);
    assert(mCaptureWakeTimer == nil); // Must be cleared before a replacement can be armed.
    ++attempts;
    auto plan = mCaptureSchedule.plan(attempts);
    assert(mCaptureSchedule.beginCapture(plan.generation, attempts));
    if (rearmOnAttempt) {
        rearmOnAttempt = NO;
        [self request:0.050];
    }
}

/* PRODUCTION_TIMER_METHODS */
@end

static dispatch_block_t lastHandler() { return [handlers lastObject]; }

static void checkBalanced() {
    assert(created == configured && created == cancelled);
}

static void synchronousCases() {
    // Repeated requests share one source; stop cancels it and invalidates its handler.
    ScreenCapturer *coalesced = [ScreenCapturer new];
    int before = created;
    for (int i = 0; i < 100; ++i) [coalesced request:0.050];
    [coalesced request:0];
    assert(created == before + 1 && coalesced->mCaptureWakeTimer);
    dispatch_block_t stopped = lastHandler();
    [coalesced stop];
    stopped();
    assert(coalesced->attempts == 0 && !coalesced->mCaptureWakeTimer);
    checkBalanced();

    // A stopped generation's handler cannot clear the restarted generation's timer.
    coalesced->mCaptureSchedule.start(60);
    [coalesced request:0.050];
    uint64_t serial = coalesced->mCaptureWakeTimerSerial;
    dispatch_block_t restarted = lastHandler();
    stopped();
    assert(coalesced->mCaptureWakeTimer && coalesced->mCaptureWakeTimerSerial == serial);
    restarted();
    assert(coalesced->attempts == 1 && !coalesced->mCaptureWakeTimer);
    [coalesced stop];
    checkBalanced();

    // A callback can rearm within the same generation; the old callback must stay inert.
    ScreenCapturer *replacement = [ScreenCapturer new];
    replacement->rearmOnAttempt = YES;
    [replacement request:0.050];
    dispatch_block_t previous = lastHandler();
    previous();
    assert(replacement->attempts == 1 && replacement->mCaptureWakeTimer);
    dispatch_block_t current = lastHandler();
    serial = replacement->mCaptureWakeTimerSerial;
    previous();
    assert(replacement->attempts == 1 && replacement->mCaptureWakeTimerSerial == serial);
    current();
    assert(replacement->attempts == 2 && !replacement->mCaptureWakeTimer);
    [replacement stop];
    checkBalanced();

    // Even retained timer callbacks must not retain their owner or prevent cancellation.
    __weak ScreenCapturer *released;
    dispatch_block_t orphan;
    @autoreleasepool {
        ScreenCapturer *owner = [ScreenCapturer new];
        released = owner;
        [owner request:0.050];
        orphan = lastHandler();
        owner = nil;
    }
    assert(released == nil);
    orphan();
    checkBalanced();
}

static void actualTimerCase() {
    ScreenCapturer *owner = [ScreenCapturer new];
    [owner request:0.005];
    assert(owner->attempts == 0 && owner->mCaptureWakeTimer);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
        assert(owner->attempts == 1 && !owner->mCaptureWakeTimer);
        [owner stop];
        checkBalanced();
        [handlers removeAllObjects];
        std::cout << "8 timer lifecycle cases passed; real host Dispatch; no device or throughput test\n";
        exit(0);
    });
}

static void immediateCases() {
    ScreenCapturer *owner = [ScreenCapturer new];
    int before = created;
    [owner request:0];
    assert(owner->attempts == 0 && created == before);
    dispatch_async(dispatch_get_main_queue(), ^{
        assert(owner->attempts == 1 && created == before);
        [owner stop];

        // An old queued immediate wake must not consume the restarted generation's request.
        ScreenCapturer *restart = [ScreenCapturer new];
        [restart request:0];
        [restart stop];
        restart->mCaptureSchedule.start(60);
        [restart request:0];

        // Immediate callbacks also hold only a weak owner reference.
        __weak ScreenCapturer *released;
        @autoreleasepool {
            ScreenCapturer *shortLived = [ScreenCapturer new];
            released = shortLived;
            [shortLived request:0];
            shortLived = nil;
        }
        assert(released == nil);
        dispatch_async(dispatch_get_main_queue(), ^{
            assert(restart->attempts == 1 && created == before);
            [restart stop];
            checkBalanced();
            actualTimerCase();
        });
    });
}

int main() {
    @autoreleasepool {
        handlers = [NSMutableArray new];
        synchronousCases();
        immediateCases();
    }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC),
                   dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{ abort(); });
    // Match the native app's main run loop; dispatch_main in a command-line
    // process can service the main queue from a thread Foundation does not mark main.
    [[NSRunLoop mainRunLoop] run];
}
