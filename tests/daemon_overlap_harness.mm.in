static rfbScreenInfo screen;
static rfbScreenInfoPtr gScreen=&screen;
static int gWidth=0,gHeight=0,gSrcWidth=0,gSrcHeight=0,gBytesPerPixel=4,gTileSize=8;
static size_t gFBSize=0;
static double gScale=1,gDeferWindowSec=0,gPendingSince=0;
static int gFullscreenThresholdPercent=60,gMaxRectsLimit=256,gMaxInflightUpdates=1;
static int gTilesX=0,gTilesY=0,gPublishedRotation=-1;
static size_t gTileCount=0;
static uint64_t *gPrevHash=nullptr,*gCurrHash=nullptr;
static uint8_t *gPendingDirty=nullptr;
static BOOL gHasPending=NO,gPublishedHashesValid=NO,gOrientationSyncEnabled=YES;
static void *gFrontBuffer=nullptr,*gBackBuffer=nullptr,*gRotateScratch=nullptr,*gScaleTemp=nullptr;
static size_t gRotateScratchSize=0,gScaleTempSize=0;
static std::atomic<int> gRotationQuad(0),gClientCount(0);
static std::atomic<bool> sForceFrameUpdate(false),gCaptureLifecycleQueued(false);
static BOOL gIsCaptureStarted=NO,gCaptureShutdown=NO;
static TVPreparedFrame gPreparedFrame;
static TVFrameUpdateRetry gFrameUpdates;
static std::mutex gPublicationAdmissionMutex;
static const int cNoScalePadThresholdPx=8;
static const BOOL cParallelFullHash=YES;
static uint64_t testNow=1000000000ULL;
static int sampleReleases=0,captureAttempts=0;
static BOOL attemptHasChange=NO;
static CMSampleBufferRef attemptSample=nullptr;
static void (^gFrameHandler)(CMSampleBufferRef)=nil;
static void tryPublishPreparedFrame(void);
typedef struct { int x,y,w,h; } DirtyRect;

@interface CADisplayLink:NSObject
@property(nonatomic) NSInteger preferredFramesPerSecond;
+ (instancetype)displayLinkWithTarget:(id)target selector:(SEL)selector;
- (void)addToRunLoop:(NSRunLoop *)loop forMode:(NSRunLoopMode)mode;
- (void)invalidate;
@end
@implementation CADisplayLink
+ (instancetype)displayLinkWithTarget:(id)target selector:(SEL)selector { (void)target;(void)selector;return [self new]; }
- (void)addToRunLoop:(NSRunLoop *)loop forMode:(NSRunLoopMode)mode { (void)loop;(void)mode; }
- (void)invalidate {}
@end
@interface UIScreen:NSObject
@property(nonatomic,readonly) NSInteger maximumFramesPerSecond;
+ (instancetype)mainScreen;
@end
@implementation UIScreen
+ (instancetype)mainScreen { static UIScreen *value=[self new];return value; }
- (NSInteger)maximumFramesPerSecond { return 60; }
@end
@interface ScreenCapturer:NSObject {
@public
    TVCaptureSchedule mCaptureSchedule;
    dispatch_source_t mCaptureWakeTimer;
    uint64_t mCaptureWakeTimerSerial;
    CADisplayLink *mDisplayLink;
    void (^mFrameHandler)(CMSampleBufferRef);
    void (^mFramePublicationHandler)(void);
    void (^mCaptureLifecycleHandler)(BOOL);
    NSInteger mMinFps,mPreferredFps,mMaxFps;
}
+ (instancetype)sharedCapturer;
- (void)forceNextFrameUpdate;
- (void)attemptCapture;
- (void)cancelCaptureWakeTimer;
- (void)onDisplayLink:(CADisplayLink *)link;
- (void)startCaptureWithFrameHandler:(void (^)(CMSampleBufferRef))handler;
- (void)endCapture;
- (void)setFramePublicationHandler:(void (^)(void))handler;
- (void)setCaptureLifecycleHandler:(void (^)(BOOL))handler;
@end
@implementation ScreenCapturer
+ (instancetype)sharedCapturer { static ScreenCapturer *value=[self new];return value; }
- (void)attemptCapture { ++captureAttempts;if(attemptHasChange && attemptSample && mFrameHandler)mFrameHandler(attemptSample); }
/* SCREEN_METHODS */
@end

static NSMutableArray *mainJobs;
static void enqueueMain(dispatch_queue_t queue,dispatch_block_t block) {
    assert(queue==dispatch_get_main_queue());
    @synchronized(mainJobs) { [mainJobs addObject:[block copy]]; }
}
static size_t jobs() { @synchronized(mainJobs) {return mainJobs.count;} }
static void drainMain() {
    for (;;) {
        dispatch_block_t block;
        @synchronized(mainJobs) {
            if (!mainJobs.count) break;
            block=mainJobs.firstObject;[mainJobs removeObjectAtIndex:0];
        }
        block();
    }
}
static std::mutex listMutex;
static std::vector<rfbClientPtr> clients;
static bool failSnapshot=false,failResize=false,failReallocation=false;
static std::function<void()> afterSnapshot;
static int snapshotCalls=0,resizeCalls=0;
static std::vector<DirtyRect> marked;
static void *lastMarkedFront=nullptr;
static int publications=0;
rfbBool rfbGetClientSnapshot(rfbScreenInfoPtr,rfbClientPtr **out,size_t *count) {
    *out=nullptr;*count=0;++snapshotCalls;
    if(failSnapshot)return false;
    {
        std::lock_guard<std::mutex> lock(listMutex);
        if(!clients.empty()) {
            *out=(rfbClientPtr *)malloc(clients.size()*sizeof(rfbClientPtr));assert(*out);
            for(size_t i=0;i<clients.size();++i) {(*out)[i]=clients[i];++clients[i]->refs;}
        }
        *count=clients.size();
    }
    if(afterSnapshot) {auto callback=afterSnapshot;callback();}
    return true;
}
void rfbReleaseClientSnapshot(rfbClientPtr *snapshot,size_t count) {
    for(size_t i=0;i<count;++i)assert(snapshot[i]->refs.fetch_sub(1)>0);
    free(snapshot);
}
rfbBool rfbNewFramebufferWithFormat(rfbScreenInfoPtr target,char *pixels,int width,int height,
                                   int bits,int samples,int bytes,const rfbPixelFormat *format) {
    ++resizeCalls;assert(bits==8&&samples==3&&bytes==4&&format);
    if(failResize)return false;
    target->frameBuffer=pixels;target->width=width;target->height=height;
    target->paddedWidthInBytes=width*bytes;target->serverFormat=*format;
    return true; // Library's actual locking/format implementation is independently tested.
}
void rfbMarkRectAsModified(rfbScreenInfoPtr target,int x1,int y1,int x2,int y2) {
    assert(target->frameBuffer==gFrontBuffer);
    assert(x1>=0&&y1>=0&&x2<=gWidth&&y2<=gHeight&&x2>x1&&y2>y1);
    if(lastMarkedFront!=gFrontBuffer) {lastMarkedFront=gFrontBuffer;++publications;marked.clear();}
    marked.push_back({x1,y1,x2-x1,y2-y1});
}
static void *testRealloc(void *old,size_t size) {return failReallocation?nullptr:realloc(old,size);}
/* PURE_FUNCTIONS */
#define realloc testRealloc
/* SCRATCH_FUNCTIONS */
#undef realloc
#define clock_gettime_nsec_np(clock) (testNow)
/* PUBLISH_AND_PREPARE */
#undef clock_gettime_nsec_np
#define dispatch_async enqueueMain
/* ASYNC_FUNCTIONS */
#undef dispatch_async
static void acceptanceBarrier() {
/* ACCEPTANCE_BARRIER */
}

static void releasePixels(void *,const void *data) {free((void *)data);++sampleReleases;}
static CMSampleBufferRef sample(uint32_t colour,int width=32,int height=16,int markTile=-1) {
    size_t stride=width*4+16;uint8_t *bytes=(uint8_t *)calloc(height,stride);assert(bytes);
    for(int y=0;y<height;++y)for(int x=0;x<width;++x) {
        uint32_t pixel=colour;
        if(markTile>=0 && x/8+(y/8)*((width+7)/8)==markTile)pixel^=0x00ffffff;
        memcpy(bytes+y*stride+x*4,&pixel,4);
    }
    CVPixelBufferRef pixel=nullptr;CMVideoFormatDescriptionRef format=nullptr;CMSampleBufferRef result=nullptr;
    assert(CVPixelBufferCreateWithBytes(kCFAllocatorDefault,width,height,kCVPixelFormatType_32BGRA,
             bytes,stride,releasePixels,nullptr,nullptr,&pixel)==kCVReturnSuccess);
    assert(CMVideoFormatDescriptionCreateForImageBuffer(kCFAllocatorDefault,pixel,&format)==noErr);
    CMSampleTimingInfo timing={CMTimeMake(1,60),kCMTimeZero,kCMTimeInvalid};
    assert(CMSampleBufferCreateForImageBuffer(kCFAllocatorDefault,pixel,true,nullptr,nullptr,format,&timing,&result)==noErr);
    CFRelease(format);CVPixelBufferRelease(pixel);return result;
}
static void prepare(uint32_t colour,int tile=-1) {
    CMSampleBufferRef buffer=sample(colour,gSrcWidth,gSrcHeight,tile);int releases=sampleReleases;
    handleFramebuffer(buffer);CFRelease(buffer);assert(sampleReleases==releases+1);
}
static uint32_t frontPixel(int x=0,int y=0) {uint32_t value;memcpy(&value,(uint8_t *)gFrontBuffer+(y*gWidth+x)*4,4);return value;}
static uint32_t backPixel(int x=0,int y=0) {uint32_t value;memcpy(&value,(uint8_t *)gBackBuffer+(y*gWidth+x)*4,4);return value;}
static void reset(rfbClient &client,int width=32,int height=16) {
    drainMain();assert(gFrameUpdates.inflight()==0);
    resetPreparedFrameSession(NO);
    {std::lock_guard<std::mutex> lock(listMutex);clients={&client};}
    gWidth=gSrcWidth=width;gHeight=gSrcHeight=height;gScale=1;gRotationQuad=0;
    gFBSize=width*height*4;free(gFrontBuffer);free(gBackBuffer);
    gFrontBuffer=calloc(1,gFBSize);gBackBuffer=calloc(1,gFBSize);
    screen.frameBuffer=(char *)gFrontBuffer;screen.width=width;screen.height=height;
    screen.paddedWidthInBytes=width*4;screen.serverFormat=rfbPixelFormat();
    initializeTilingOrReset();resetPreparedFrameSession(YES);
    gDeferWindowSec=0;gFullscreenThresholdPercent=60;gMaxRectsLimit=256;
    testNow+=1000000000ULL;publications=0;marked.clear();lastMarkedFront=nullptr;
    failSnapshot=failResize=failReallocation=false;afterSnapshot=nullptr;
    sForceFrameUpdate=false;attemptHasChange=NO;attemptSample=nullptr;gCaptureShutdown=NO;
    gClientCount=1;assert(client.refs==0);
}
static void tick() {[[ScreenCapturer sharedCapturer] onDisplayLink:nil];}

int main() {
    @autoreleasepool {
        mainJobs=[NSMutableArray new];
        ScreenCapturer *capturer=[ScreenCapturer sharedCapturer];
        [capturer setFramePublicationHandler:^{tryPublishPreparedFrame();}];
        [capturer setCaptureLifecycleHandler:^(BOOL active){resetPreparedFrameSession(active);}];
        gFrameHandler=^(CMSampleBufferRef buffer){handleFramebuffer(buffer);};
        [capturer startCaptureWithFrameHandler:gFrameHandler];
        rfbClient client,second,newcomer;unsigned cases=0;
        const uint32_t A=0xff332211,B=0xff665544,C=0xff998877;

        // Real CoreVideo inputs, exact copy/hash/preparation/publisher; no retained samples.
        reset(client);prepare(A);assert(publications==1&&frontPixel()==A&&!gPreparedFrame.valid);
        void *firstFront=gFrontBuffer,*firstBack=gBackBuffer;
        std::atomic<int> phase{0};
        std::thread encoder([&]{
            pthread_mutex_lock(&client.sendMutex);displayHook(&client);phase=1;
            while(phase==1){assert(frontPixel()==A);std::this_thread::yield();}
            displayFinishedHook(&client,1);phase=3;
            while(phase==3)std::this_thread::yield();
            pthread_mutex_unlock(&client.sendMutex);
        });
        while(phase!=1)std::this_thread::yield();
        prepare(B);prepare(C);assert(gPreparedFrame.valid&&frontPixel()==A&&backPixel()==C);
        assert(gFrontBuffer==firstFront&&gBackBuffer==firstBack&&publications==1);
        sForceFrameUpdate=false;phase=2;while(phase!=3)std::this_thread::yield();
        assert(jobs()==1);drainMain();assert(gPreparedFrame.valid&&publications==1&&!sForceFrameUpdate);
        phase=4;encoder.join();int before=captureAttempts;tick();
        assert(captureAttempts==before+1&&publications==2&&frontPixel()==C&&!gPreparedFrame.valid);++cases;

        // Identical output after a source-side dirty event creates no redundant full encode.
        reset(client);prepare(A);int sends=publications;uint64_t *baseline=gPrevHash;
        prepare(A);assert(publications==sends&&!gPreparedFrame.valid&&!gHasPending&&gPrevHash==baseline);++cases;

        // Pending mask unions replacements and preserves exact current hashes, including prev^1.
        reset(client);prepare(A);pthread_mutex_lock(&client.sendMutex);displayHook(&client);
        prepare(A,0);prepare(A,7);assert(gPendingDirty[0]&&gPendingDirty[7]);
        gPrevHash[0]=0x1234;gCurrHash[0]=0x1235;DirtyRect rects[32];int changed=0;BOOL overflow=NO;
        buildDirtyRects(rects,32,&changed,&overflow);assert(gCurrHash[0]==0x1235&&!overflow&&changed==2);
        // Rebuild the exact current baseline before publishing after the synthetic hash test.
        hashFullBackBuffer();displayFinishedHook(&client,1);pthread_mutex_unlock(&client.sendMutex);drainMain();
        assert(!gPreparedFrame.valid&&frontPixel()==A&&frontPixel(24,8)==(A^0x00ffffff));
        assert(marked.size()==2);++cases;

        // Exhausting rectangle capacity cannot omit a later dirty tile.
        reset(client,32,32);prepare(A);pthread_mutex_lock(&client.sendMutex);displayHook(&client);
        prepare(A,0);prepare(A,15);gMaxRectsLimit=1;displayFinishedHook(&client,1);
        pthread_mutex_unlock(&client.sendMutex);drainMain();
        assert(marked.size()==1&&marked[0].w==32&&marked[0].h==32);++cases;

        // A slow second client rolls back partial locks and references; CAD retries later.
        reset(client);prepare(A);{std::lock_guard<std::mutex> lock(listMutex);clients.push_back(&second);}
        pthread_mutex_lock(&second.sendMutex);prepare(B);
        assert(gPreparedFrame.valid&&client.refs==0&&second.refs==0&&frontPixel()==A);
        assert(pthread_mutex_trylock(&client.sendMutex)==0);pthread_mutex_unlock(&client.sendMutex);
        pthread_mutex_unlock(&second.sendMutex);tick();assert(frontPixel()==B&&!gPreparedFrame.valid);++cases;

        // Snapshot OOM does not consume prepared pixels; no client references escape.
        reset(client);prepare(A);failSnapshot=true;prepare(B);
        assert(gPreparedFrame.valid&&frontPixel()==A&&backPixel()==B&&client.refs==0);
        failSnapshot=false;tick();assert(frontPixel()==B);++cases;

        // Hash baseline and defer deadline survive repeated preparations until one publication.
        reset(client);prepare(A);baseline=gPrevHash;gDeferWindowSec=0.02;prepare(B);
        uint64_t deadline=(uint64_t)(gPendingSince*1e9)+20000000ULL;
        testNow+=10000000;prepare(C);assert(gPrevHash==baseline&&gPreparedFrame.valid&&publications==1);
        testNow=deadline+1;tick();assert(frontPixel()==C&&publications==2&&!gHasPending);++cases;

        // New client linked after snapshot cannot begin reading before publication commits.
        reset(client);prepare(A);std::atomic<bool> inserted{false},accepted{false};std::thread joiner;
        afterSnapshot=[&]{
            afterSnapshot=nullptr;
            joiner=std::thread([&]{
                {std::lock_guard<std::mutex> lock(listMutex);clients.push_back(&newcomer);}
                inserted=true;acceptanceBarrier();accepted=true;assert(frontPixel()==B);
            });
            while(!inserted)std::this_thread::yield();assert(!accepted);
        };
        prepare(B);joiner.join();assert(accepted&&frontPixel()==B);++cases;

        // Last reader leaves while the new reader joins before queued lifecycle work runs.
        reset(client);gIsCaptureStarted=YES;gClientCount=0;requestCaptureLifecycleReconcile();
        gClientCount=1;requestCaptureLifecycleReconcile();assert(jobs()==1);
        uint64_t liveWake=gFrameUpdates.queuePublication();drainMain();
        assert(gIsCaptureStarted&&gFrameUpdates.active()&&gFrameUpdates.takePublication(liveWake));
        // A real stop followed by start rejects the old completion generation.
        uint64_t oldWake=gFrameUpdates.queuePublication();gClientCount=0;requestCaptureLifecycleReconcile();drainMain();
        assert(!gIsCaptureStarted&&!gFrameUpdates.active());gClientCount=1;requestCaptureLifecycleReconcile();drainMain();
        assert(gIsCaptureStarted&&gFrameUpdates.active()&&!gFrameUpdates.takePublication(oldWake));
        prepare(C);assert(frontPixel()==C);++cases;

        // Hundreds of completions queue at most one scalar publication callback.
        reset(client);for(int i=0;i<1000;++i){displayHook(&client);displayFinishedHook(&client,1);}
        assert(jobs()==1);sForceFrameUpdate=false;drainMain();assert(!sForceFrameUpdate&&gFrameUpdates.inflight()==0);++cases;

        // Same-size and resized rotations preserve complete pixels and final BGRA format.
        reset(client);prepare(A,0);gRotationQuad=2;prepare(A,0);
        assert(frontPixel(31,15)==(A^0x00ffffff)&&frontPixel()==A&&gPublishedRotation==2);
        gRotationQuad=1;prepare(A,0);assert(gWidth==16&&gHeight==32&&gPublishedRotation==1);
        assert(screen.serverFormat.redShift==16&&screen.serverFormat.greenShift==8&&screen.serverFormat.blueShift==0);++cases;

        // Failed geometry adoption retains all old ownership and prepared pixels for retry.
        reset(client);prepare(A);pthread_mutex_lock(&client.sendMutex);prepare(B);pthread_mutex_unlock(&client.sendMutex);
        void *oldFront=gFrontBuffer,*oldBack=gBackBuffer;uint64_t *oldHashes=gPrevHash;
        gRotationQuad=1;failResize=true;prepare(C);
        assert(gFrontBuffer==oldFront&&gBackBuffer==oldBack&&gWidth==32&&gHeight==16);
        assert(gPreparedFrame.valid&&gPrevHash==oldHashes&&sForceFrameUpdate&&backPixel()==B);
        failResize=false;prepare(C);assert(gWidth==16&&gHeight==32&&frontPixel()==C);++cases;

        // Realloc failure leaves old rotation/scale scratch storage owned and untouched.
        assert(ensureRotateScratch(8,8)==0);void *oldScratch=gRotateScratch;size_t oldSize=gRotateScratchSize;
        failReallocation=true;assert(ensureRotateScratch(oldSize,8)==-1);
        assert(gRotateScratch==oldScratch&&gRotateScratchSize==oldSize);
        failReallocation=false;assert(ensureScaleTemp(32,16,256,128,kvImageHighQualityResampling)==0);
        void *oldScale=gScaleTemp;size_t oldScaleSize=gScaleTempSize;
        failReallocation=true;int scaleResult=ensureScaleTemp(1024,1024,2048,2048,kvImageHighQualityResampling);
        assert(scaleResult==-1&&gScaleTemp==oldScale&&gScaleTempSize==oldScaleSize);failReallocation=false;++cases;

        // A failed preparation never exposes overwritten/partial back pixels.
        reset(client);prepare(A);gRotationQuad=1;failReallocation=true;
        gRotateScratchSize=0;prepare(B);assert(!gPreparedFrame.valid&&sForceFrameUpdate);
        failReallocation=false;prepare(C);assert(frontPixel()==C&&!gPreparedFrame.valid);++cases;

        printf("overlap_cases=%u; actual handler/publisher/hash/CAD/lifecycle pieces; host only\n",cases);
        [capturer endCapture];drainMain();
        assert(client.refs==0&&second.refs==0&&newcomer.refs==0);
        free(gFrontBuffer);free(gBackBuffer);free(gPrevHash);free(gCurrHash);free(gPendingDirty);
        free(gRotateScratch);free(gScaleTemp);
        pthread_mutex_destroy(&client.sendMutex);pthread_mutex_destroy(&second.sendMutex);pthread_mutex_destroy(&newcomer.sendMutex);
    }
}
