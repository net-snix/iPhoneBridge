/* Host regression. Modified production C is extracted from the canonical patch.
 * Narrow types/regions model the fields those bodies access; pthread locks, waits,
 * reference counts and deallocation are real. This is not a daemon build. */
#define _POSIX_C_SOURCE 200809L
#include <errno.h>
#include <pthread.h>
#include <stdarg.h>
#include <stdatomic.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#define LIBVNCSERVER_HAVE_LIBPTHREAD 1
#define TRUE 1
#define FALSE 0
#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #x); exit(2); } } while (0)
typedef char rfbBool;
typedef struct Client *rfbClientPtr;
typedef struct Screen *rfbScreenInfoPtr;
typedef struct rfbClientIterator *rfbClientIteratorPtr;
typedef struct { uint8_t bitsPerPixel, depth, bigEndian, trueColour;
    uint16_t redMax, greenMax, blueMax;
    uint8_t redShift, greenShift, blueShift, pad1; uint16_t pad2;
} rfbPixelFormat;
typedef struct { pthread_mutex_t raw; atomic_int owner; int kind, id; } TestMutex;
typedef struct { int width, height, empty; } Region;
enum { MAIN=1, RESIZE, SENDER, REMOVE_A, REMOVE_B, READER };
enum { GENERAL, LIST, SEND, CURSOR, REF, ADMISSION };
enum { SEND_HELD, RESIZE_WAITING, A_WAITING, B_WAITING, READER_WAITING, RELEASE_SENDER,
    ALLOCATION_ENTERED, RELEASE_ALLOCATION, REMOVAL_ATTEMPT, SNAPSHOT_READY, RELEASE_SNAPSHOT, EVENT_COUNT };
static _Thread_local int role = MAIN;
static pthread_mutex_t event_mutex = PTHREAD_MUTEX_INITIALIZER;
static pthread_cond_t event_condition = PTHREAD_COND_INITIALIZER;
static int events[EVENT_COUNT];
static void event(int index) {
    CHECK(pthread_mutex_lock(&event_mutex)==0); events[index]=1;
    CHECK(pthread_cond_broadcast(&event_condition)==0);
    CHECK(pthread_mutex_unlock(&event_mutex)==0);
}
static void await_event(int index) {
    CHECK(pthread_mutex_lock(&event_mutex)==0);
    while (!events[index]) CHECK(pthread_cond_wait(&event_condition,&event_mutex)==0);
    CHECK(pthread_mutex_unlock(&event_mutex)==0);
}
struct Probe { atomic_int disposed, admitted, translated; int expected_width;
    rfbPixelFormat translated_format; };
struct Screen { rfbClientPtr clientHead; TestMutex cursorMutex;
    int width,height,bitsPerPixel,depth,paddedWidthInBytes,cursorX,cursorY,backgroundLoop;
    rfbPixelFormat serverFormat; char *frameBuffer;
    struct { int count,is16; union { char *bytes; } data; } colourMap;
    rfbBool (*setTranslateFunction)(rfbClientPtr);
};
struct Client { rfbClientPtr next,prev; rfbScreenInfoPtr screen; int sock,refCount;
    rfbPixelFormat format;
    TestMutex refCountMutex,sendMutex,updateMutex; pthread_cond_t deleteCond,updateCond;
    Region *modifiedRegion,*copyRegion; int copyDX,copyDY,useNewFBSize,newFBSizePending;
    struct Probe *probe; };
static TestMutex rfbClientListMutex, admission;
static rfbClientPtr close_at_cursor;
static atomic_int fail_allocation, pause_allocation, allocation_calls, allocation_live, errors;
static unsigned initializer_calls, observed_initializations;
static int observe_initialization;
static rfbPixelFormat format_seen_before_admission;
static int rfbEndianTest=1;
static void init_mutex(TestMutex *m,int kind,int id) {
    pthread_mutexattr_t attr; CHECK(pthread_mutexattr_init(&attr)==0);
    CHECK(pthread_mutexattr_settype(&attr,PTHREAD_MUTEX_ERRORCHECK)==0);
    CHECK(pthread_mutex_init(&m->raw,&attr)==0); CHECK(pthread_mutexattr_destroy(&attr)==0);
    atomic_init(&m->owner,0); m->kind=kind; m->id=id;
}
static void lock_mutex(TestMutex *m) {
    if (role==REMOVE_A && m->kind==LIST) event(REMOVAL_ATTEMPT);
    if (role==RESIZE && m->kind==SEND) {
        CHECK(atomic_load(&rfbClientListMutex.owner)!=RESIZE);
        if (m->id==2) event(RESIZE_WAITING);
    }
    CHECK(pthread_mutex_lock(&m->raw)==0); atomic_store(&m->owner,role);
    if (m->kind==CURSOR && close_at_cursor) {
        close_at_cursor->sock=-1; close_at_cursor=NULL;
    }
}
static void unlock_mutex(TestMutex *m) {
    CHECK(atomic_load(&m->owner)==role); atomic_store(&m->owner,0);
    CHECK(pthread_mutex_unlock(&m->raw)==0);
}
static void wait_condition(pthread_cond_t *c,TestMutex *m) {
    if (role==REMOVE_A) event(A_WAITING);
    if (role==REMOVE_B) event(B_WAITING);
    atomic_store(&m->owner,0);
    CHECK(pthread_cond_wait(c,&m->raw)==0); atomic_store(&m->owner,role);
}
#define LOCK(m) lock_mutex(&(m))
#define UNLOCK(m) unlock_mutex(&(m))
#define WAIT(c,m) wait_condition(&(c),&(m))
#define TSIGNAL(c) CHECK(pthread_cond_signal(&(c))==0)
#define MUTEX(m) TestMutex m
static void *snapshot_malloc(size_t length) {
    atomic_fetch_add(&allocation_calls,1);
    CHECK(atomic_load(&rfbClientListMutex.owner)==role);
    if (atomic_load(&fail_allocation)) return NULL;
    if (atomic_load(&pause_allocation)) { event(ALLOCATION_ENTERED); await_event(RELEASE_ALLOCATION); }
    void *p=malloc(length); if (p) atomic_fetch_add(&allocation_live,1); return p;
}
static void snapshot_free(void *p) {
    if (p) atomic_fetch_sub(&allocation_live,1); free(p);
}
static void rfbErr(const char *format,...) { (void)format; atomic_fetch_add(&errors,1); }
static Region *sraRgnCreateRect(int x,int y,int width,int height) {
    (void)x; (void)y; Region *r=calloc(1,sizeof(*r)); CHECK(r); r->width=width; r->height=height; return r;
}
static void sraRgnDestroy(Region *r) { free(r); }
static void sraRgnMakeEmpty(Region *r) { r->empty=1; }
static rfbBool translate(rfbClientPtr cl) {
    CHECK(atomic_load(&cl->sendMutex.owner)==role);
    CHECK(atomic_load(&cl->screen->cursorMutex.owner)==role);
    CHECK(atomic_load(&rfbClientListMutex.owner)!=role);
    CHECK(atomic_load(&admission.owner)==role);
    cl->probe->translated_format=cl->screen->serverFormat;
    atomic_fetch_add(&cl->probe->translated,1); return TRUE;
}
/* PRODUCTION_REFS */
#define malloc snapshot_malloc
#define free snapshot_free
/* PRODUCTION_SNAPSHOT */
#undef malloc
#undef free
#define rfbInitServerFormat pinned_rfbInitServerFormat
/* PRODUCTION_FORMAT */
#undef rfbInitServerFormat
static void rfbInitServerFormat(rfbScreenInfoPtr screen,int bitsPerSample) {
    ++initializer_calls; pinned_rfbInitServerFormat(screen,bitsPerSample);
    if (observe_initialization) {
        /* Model the pinned new-client copy before list insertion/admission. */
        struct Client joining={0}; rfbClientPtr cl=&joining; cl->screen=screen;
        cl->format = cl->screen->serverFormat;
        format_seen_before_admission=cl->format; ++observed_initializations;
    }
}
/* PRODUCTION_RESIZE */
static void dispose_client(rfbClientPtr cl) {
    CHECK(cl->refCount==0); CHECK(atomic_load(&cl->sendMutex.owner)==0);
    CHECK(pthread_mutex_trylock(&cl->sendMutex.raw)==0);
    CHECK(pthread_mutex_unlock(&cl->sendMutex.raw)==0);
    if (cl->probe->expected_width) CHECK(cl->modifiedRegion->width==cl->probe->expected_width);
    atomic_store(&cl->probe->disposed,1);
    sraRgnDestroy(cl->modifiedRegion); sraRgnDestroy(cl->copyRegion);
    CHECK(pthread_mutex_destroy(&cl->sendMutex.raw)==0);
    CHECK(pthread_mutex_destroy(&cl->updateMutex.raw)==0);
    CHECK(pthread_mutex_destroy(&cl->refCountMutex.raw)==0);
    CHECK(pthread_cond_destroy(&cl->deleteCond)==0); CHECK(pthread_cond_destroy(&cl->updateCond)==0);
    free(cl);
}
/* PRODUCTION_UNLINK_AND_WAIT */
static rfbPixelFormat bgra_format(void) {
    rfbPixelFormat f={0}; f.bitsPerPixel=32; f.depth=24; f.trueColour=1;
    f.redMax=f.greenMax=f.blueMax=255; f.redShift=16; f.greenShift=8; return f;
}
static void init_screen(struct Screen *s,char *frame) {
    memset(s,0,sizeof(*s)); init_mutex(&s->cursorMutex,CURSOR,0);
    s->backgroundLoop=1; s->width=4; s->height=3; s->bitsPerPixel=s->depth=32;
    s->paddedWidthInBytes=16; s->cursorX=s->cursorY=3; s->frameBuffer=frame;
    s->setTranslateFunction=translate; rfbInitServerFormat(s,8);
}
static rfbClientPtr add_client(struct Screen *s,struct Probe *probe,int id) {
    rfbClientPtr cl=calloc(1,sizeof(*cl)); CHECK(cl); cl->screen=s; cl->sock=id;
    cl->probe=probe; cl->useNewFBSize=1; cl->copyDX=cl->copyDY=1;
    init_mutex(&cl->sendMutex,SEND,id); init_mutex(&cl->refCountMutex,REF,id);
    init_mutex(&cl->updateMutex,GENERAL,id);
    CHECK(pthread_cond_init(&cl->deleteCond,NULL)==0); CHECK(pthread_cond_init(&cl->updateCond,NULL)==0);
    cl->modifiedRegion=sraRgnCreateRect(0,0,s->width,s->height);
    cl->copyRegion=sraRgnCreateRect(0,0,1,1);
    LOCK(rfbClientListMutex); cl->next=s->clientHead;
    if (s->clientHead) s->clientHead->prev=cl; s->clientHead=cl; UNLOCK(rfbClientListMutex);
    return cl;
}
static int references(rfbClientPtr cl) {
    LOCK(cl->refCountMutex); int n=cl->refCount; UNLOCK(cl->refCountMutex); return n;
}
static void check_updated(rfbClientPtr cl,int width,int height) {
    CHECK(cl->modifiedRegion->width==width && cl->modifiedRegion->height==height);
    CHECK(cl->copyRegion->empty && cl->copyDX==0 && cl->copyDY==0 && cl->newFBSizePending);
    CHECK(references(cl)==0 && atomic_load(&cl->sendMutex.owner)==0);
}
static void legacy_resize(struct Screen *s,char *next) {
    role=RESIZE; LOCK(admission); rfbNewFramebuffer(s,next,8,6,8,3,4); UNLOCK(admission); role=MAIN;
}
static rfbBool formatted_resize(struct Screen *s,char *next,const rfbPixelFormat *format) {
    role=RESIZE; LOCK(admission);
    rfbBool result=rfbNewFramebufferWithFormat(s,next,8,6,8,3,4,format);
    UNLOCK(admission); role=MAIN; return result;
}
static void test_empty(void) {
    char old[48],next[192]; struct Screen s; init_screen(&s,old);
    legacy_resize(&s,next); CHECK(s.frameBuffer==next && s.width==8 && s.height==6);
    CHECK(atomic_load(&allocation_calls)==0);
    CHECK(atomic_load(&allocation_live)==0);
}
static void test_closed_lock_set(void) {
    char old[48],next[192]; struct Screen s; struct Probe a={0},b={0}; init_screen(&s,old);
    rfbClientPtr cb=add_client(&s,&b,2),ca=add_client(&s,&a,1);
    close_at_cursor=ca; legacy_resize(&s,next);
    check_updated(ca,8,6); check_updated(cb,8,6);
    rfbClientConnectionGone(ca); rfbClientConnectionGone(cb);
    CHECK(atomic_load(&allocation_live)==0);
}
static void test_format(void) {
    char old[48],next[192]; struct Screen s; struct Probe a={0}; init_screen(&s,old);
    s.serverFormat=bgra_format(); s.serverFormat.depth=32;
    rfbClientPtr ca=add_client(&s,&a,1); rfbPixelFormat desired=bgra_format();
    CHECK(formatted_resize(&s,next,&desired));
    CHECK(atomic_load(&a.translated)==1);
    CHECK(memcmp(&a.translated_format,&desired,sizeof(desired))==0);
    /* B=0x17, G=0x52, R=0xc9 must not become R=0x17, B=0xc9. */
    uint32_t asymmetric=0x00c95217;
    CHECK(((asymmetric>>a.translated_format.redShift)&255)==0xc9);
    CHECK(((asymmetric>>a.translated_format.blueShift)&255)==0x17);
    CHECK(s.frameBuffer==next && s.depth==24); check_updated(ca,8,6); rfbClientConnectionGone(ca);
}
static void test_format_alias_and_legacy(void) {
    char old[48],next[192]; struct Screen s; struct Probe a={0}; init_screen(&s,old);
    s.serverFormat=bgra_format(); rfbClientPtr ca=add_client(&s,&a,1);
    CHECK(formatted_resize(&s,next,&s.serverFormat)); CHECK(s.serverFormat.redShift==16);
    CHECK(atomic_load(&a.translated)==0); /* No transient wrong format rebuild. */
    legacy_resize(&s,old); CHECK(s.serverFormat.redShift==0 && s.serverFormat.blueShift==16);
    CHECK(atomic_load(&a.translated)==1); CHECK(s.depth==32); rfbClientConnectionGone(ca);
}
static void test_unchanged_explicit_format_has_no_initializer_window(void) {
    char old[48],next[192],colour_map[4]; struct Screen s; struct Probe a={0}; init_screen(&s,old);
    s.serverFormat=bgra_format(); s.depth=s.serverFormat.depth;
    /* Include non-color bytes when verifying complete unchanged-format identity. */
    s.serverFormat.pad1=0xa7; s.serverFormat.pad2=0x39c1;
    rfbPixelFormat original=s.serverFormat; rfbClientPtr ca=add_client(&s,&a,1);
    s.colourMap.count=2; s.colourMap.is16=1; s.colourMap.data.bytes=colour_map;
    initializer_calls=observed_initializations=0; observe_initialization=1;
    CHECK(formatted_resize(&s,next,&s.serverFormat));
    CHECK(!observed_initializations || memcmp(&format_seen_before_admission,&original,sizeof(original))==0);
    CHECK(initializer_calls==0 && observed_initializations==0);
    CHECK(memcmp(&s.serverFormat,&original,sizeof(original))==0 && s.depth==original.depth);
    CHECK(s.colourMap.count==0 && s.colourMap.is16==0 && s.colourMap.data.bytes==NULL);
    CHECK(atomic_load(&a.translated)==0); check_updated(ca,8,6);
    legacy_resize(&s,old);
    CHECK(initializer_calls==1 && observed_initializations==1);
    CHECK(format_seen_before_admission.redShift==0 && format_seen_before_admission.blueShift==16);
    CHECK(s.serverFormat.redShift==0 && s.serverFormat.blueShift==16 && s.depth==32);
    observe_initialization=0; rfbClientConnectionGone(ca);
}
static void test_allocation_failure(void) {
    char old[48],next[192]; struct Screen s; struct Probe a={0}; init_screen(&s,old);
    rfbClientPtr ca=add_client(&s,&a,1); rfbPixelFormat original=s.serverFormat,desired=bgra_format();
    atomic_store(&fail_allocation,1); rfbClientPtr *clients=(void *)(uintptr_t)1; size_t count=99;
    CHECK(!rfbGetClientSnapshot(&s,&clients,&count)); CHECK(clients==NULL && count==0);
    CHECK(!formatted_resize(&s,next,&desired));
    CHECK(s.frameBuffer==old && s.width==4 && s.height==3 && s.paddedWidthInBytes==16);
    CHECK(memcmp(&s.serverFormat,&original,sizeof(original))==0 && references(ca)==0);
    CHECK(atomic_load(&a.translated)==0 && atomic_load(&ca->sendMutex.owner)==0);
    CHECK(ca->modifiedRegion->width==4 && !ca->newFBSizePending);
    CHECK(atomic_load(&rfbClientListMutex.owner)==0 && atomic_load(&allocation_live)==0);
    CHECK(atomic_load(&errors)==1); atomic_store(&fail_allocation,0); rfbClientConnectionGone(ca);
}
static void test_invalid_format(void) {
    char old[48],next[192]; struct Screen s; init_screen(&s,old);
    rfbPixelFormat f=bgra_format(); f.bitsPerPixel=16;
    CHECK(!formatted_resize(&s,next,&f)); CHECK(s.frameBuffer==old && s.width==4);
    CHECK(atomic_load(&allocation_calls)==0 && atomic_load(&errors)==1);
}
static void test_empty_snapshot(void) {
    struct Screen s; char old[48]; init_screen(&s,old); rfbClientPtr *items=(void *)(uintptr_t)1; size_t count=99;
    atomic_store(&fail_allocation,1); CHECK(rfbGetClientSnapshot(&s,&items,&count));
    CHECK(items==NULL && count==0 && atomic_load(&allocation_calls)==0);
    rfbReleaseClientSnapshot(items,count); CHECK(atomic_load(&allocation_live)==0);
}
struct Task { struct Screen *screen; rfbClientPtr client; struct Probe *probe; char *next; int role; };
static void *remove_thread(void *arg) {
    struct Task *t=arg; role=t->role; rfbClientConnectionGone(t->client); return NULL;
}
static void *sender_thread(void *arg) {
    struct Task *t=arg; role=SENDER; rfbIncrClientRef(t->client); LOCK(t->client->sendMutex);
    event(SEND_HELD); await_event(RELEASE_SENDER); UNLOCK(t->client->sendMutex); rfbDecrClientRef(t->client); return NULL;
}
static void *resize_thread(void *arg) {
    struct Task *t=arg; role=RESIZE; LOCK(admission);
    rfbNewFramebuffer(t->screen,t->next,8,6,8,3,4); UNLOCK(admission); return NULL;
}
static void *reader_thread(void *arg) {
    struct Task *t=arg; role=READER; t->client=add_client(t->screen,t->probe,3);
    /* Real library inserts before newClientHook; only ACCEPT starts the reader. */
    event(READER_WAITING); LOCK(admission);
    CHECK(t->screen->frameBuffer==t->next && t->screen->width==8);
    atomic_store(&t->probe->admitted,1); UNLOCK(admission); return NULL;
}
static void test_blocked_resize_disconnect_and_admission(void) {
    char old[48],next[192]; struct Screen s; struct Probe a={0},b={0},c={0}; init_screen(&s,old);
    a.expected_width=b.expected_width=8;
    rfbClientPtr cb=add_client(&s,&b,2),ca=add_client(&s,&a,1);
    struct Task ta={&s,ca,&a,next,REMOVE_A},tb={&s,cb,&b,next,REMOVE_B},tc={&s,NULL,&c,next,READER};
    pthread_t sender,resizer,remover_a,remover_b,reader;
    CHECK(pthread_create(&sender,NULL,sender_thread,&tb)==0); await_event(SEND_HELD);
    CHECK(pthread_create(&resizer,NULL,resize_thread,&tb)==0); await_event(RESIZE_WAITING);
    CHECK(references(ca)==1 && references(cb)==2); /* Original iterator drops A too early. */
    CHECK(pthread_create(&remover_a,NULL,remove_thread,&ta)==0); await_event(A_WAITING);
    CHECK(pthread_create(&remover_b,NULL,remove_thread,&tb)==0); await_event(B_WAITING);
    LOCK(rfbClientListMutex); CHECK(s.clientHead==NULL); UNLOCK(rfbClientListMutex);
    CHECK(!atomic_load(&a.disposed) && !atomic_load(&b.disposed));
    CHECK(s.frameBuffer==old); CHECK(atomic_load(&admission.owner)==RESIZE);
    CHECK(pthread_create(&reader,NULL,reader_thread,&tc)==0); await_event(READER_WAITING);
    CHECK(!atomic_load(&c.admitted)); event(RELEASE_SENDER);
    CHECK(pthread_join(sender,NULL)==0); CHECK(pthread_join(resizer,NULL)==0);
    CHECK(pthread_join(remover_a,NULL)==0); CHECK(pthread_join(remover_b,NULL)==0); CHECK(pthread_join(reader,NULL)==0);
    CHECK(atomic_load(&a.disposed) && atomic_load(&b.disposed) && atomic_load(&c.admitted));
    CHECK(references(tc.client)==0); CHECK(atomic_load(&allocation_live)==0); rfbClientConnectionGone(tc.client);
}
static void *snapshot_thread(void *arg) {
    struct Task *t=arg; role=RESIZE; rfbClientPtr *items=NULL; size_t count=0;
    CHECK(rfbGetClientSnapshot(t->screen,&items,&count)); CHECK(count==2);
    event(SNAPSHOT_READY); await_event(RELEASE_SNAPSHOT); rfbReleaseClientSnapshot(items,count); return NULL;
}
static void test_atomic_snapshot_acquisition(void) {
    char old[48]; struct Screen s; struct Probe a={0},b={0}; init_screen(&s,old);
    rfbClientPtr cb=add_client(&s,&b,2),ca=add_client(&s,&a,1);
    struct Task ta={&s,ca,&a,NULL,REMOVE_A},tb={&s,cb,&b,NULL,REMOVE_B}; pthread_t snapshot,ra,rb;
    atomic_store(&pause_allocation,1);
    CHECK(pthread_create(&snapshot,NULL,snapshot_thread,&ta)==0); await_event(ALLOCATION_ENTERED);
    CHECK(pthread_create(&ra,NULL,remove_thread,&ta)==0); await_event(REMOVAL_ATTEMPT);
    /* Removal cannot pass list protection before the snapshot owns its first ref. */
    CHECK(atomic_load(&rfbClientListMutex.owner)==RESIZE && references(ca)==0 && !atomic_load(&a.disposed));
    event(RELEASE_ALLOCATION); await_event(SNAPSHOT_READY); await_event(A_WAITING);
    CHECK(references(ca)==1 && references(cb)==1);
    CHECK(pthread_create(&rb,NULL,remove_thread,&tb)==0); await_event(B_WAITING);
    event(RELEASE_SNAPSHOT); CHECK(pthread_join(snapshot,NULL)==0);
    CHECK(pthread_join(ra,NULL)==0); CHECK(pthread_join(rb,NULL)==0);
    CHECK(atomic_load(&a.disposed) && atomic_load(&b.disposed) && atomic_load(&allocation_live)==0);
}
static void test_snapshot_survives_a_b_removal(void) {
    char old[48]; struct Screen s; struct Probe a={0},b={0}; init_screen(&s,old);
    rfbClientPtr cb=add_client(&s,&b,2),ca=add_client(&s,&a,1),*items=NULL; size_t count=0;
    ca->sock=-1; /* Closed-but-linked clients still own a lock/lifetime. */
    CHECK(rfbGetClientSnapshot(&s,&items,&count)); CHECK(count==2 && items[0]==ca && items[1]==cb);
    struct Task ta={&s,ca,&a,NULL,REMOVE_A},tb={&s,cb,&b,NULL,REMOVE_B}; pthread_t ra,rb;
    CHECK(pthread_create(&ra,NULL,remove_thread,&ta)==0); await_event(A_WAITING);
    CHECK(pthread_create(&rb,NULL,remove_thread,&tb)==0); await_event(B_WAITING);
    CHECK(!atomic_load(&a.disposed) && !atomic_load(&b.disposed));
    CHECK(items[0]==ca && items[1]==cb && references(ca)==1 && references(cb)==1);
    rfbReleaseClientSnapshot(items,count); CHECK(pthread_join(ra,NULL)==0); CHECK(pthread_join(rb,NULL)==0);
    CHECK(atomic_load(&a.disposed) && atomic_load(&b.disposed) && atomic_load(&allocation_live)==0);
}
int main(int argc,char **argv) {
    CHECK(argc==2); alarm(10); init_mutex(&rfbClientListMutex,LIST,0); init_mutex(&admission,ADMISSION,0);
    if (!strcmp(argv[1],"empty")) test_empty();
    else if (!strcmp(argv[1],"closed_lock_set")) test_closed_lock_set();
    else if (!strcmp(argv[1],"format")) test_format();
    else if (!strcmp(argv[1],"blocked_resize_disconnect_admission")) test_blocked_resize_disconnect_and_admission();
    else if (!strcmp(argv[1],"format_alias_legacy")) test_format_alias_and_legacy();
    else if (!strcmp(argv[1],"allocation_failure")) test_allocation_failure();
    else if (!strcmp(argv[1],"invalid_format")) test_invalid_format();
    else if (!strcmp(argv[1],"empty_snapshot")) test_empty_snapshot();
    else if (!strcmp(argv[1],"snapshot_a_b_removal")) test_snapshot_survives_a_b_removal();
    else if (!strcmp(argv[1],"atomic_snapshot_acquisition")) test_atomic_snapshot_acquisition();
    else if (!strcmp(argv[1],"unchanged_explicit_format")) test_unchanged_explicit_format_has_no_initializer_window();
    else CHECK(0);
    CHECK(atomic_load(&rfbClientListMutex.owner)==0 && atomic_load(&admission.owner)==0);
    printf("PASS %s\n",argv[1]); return 0;
}
