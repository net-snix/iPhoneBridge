         return [NSString stringWithCharacters:&ch length:1];
     }
     switch (ks) {
     case XK_Return:
     case XK_KP_Enter:
         return @"RETURN";
     case XK_Tab:
         return @"TAB";
     case XK_Escape:
         return @"ESCAPE";
     case XK_BackSpace:
         return @"BACKSPACE";
     case XK_Delete:
         return @"FORWARDDELETE";
     case XK_Insert:
         return @"INSERT";
     case XK_Home:
         return @"HOME";
     case XK_End:
         return @"END";
     case XK_Page_Up:
         return @"PAGEUP";
     case XK_Page_Down:
         return @"PAGEDOWN";
     case XK_Left:
         return @"LEFTARROW";
     case XK_Right:
         return @"RIGHTARROW";
     case XK_Up:
         return @"UPARROW";
     case XK_Down:
         return @"DOWNARROW";
