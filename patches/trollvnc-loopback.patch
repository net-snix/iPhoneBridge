diff --git a/src/ClientSendLocks.h b/src/ClientSendLocks.h
new file mode 100644
index 0000000..2528646
--- /dev/null
+++ b/src/ClientSendLocks.h
@@ -0,0 +1,56 @@
+/*
+ * iPhoneBridge framebuffer client locks, 2026-09-09.
+ * Copyright (c) 2026 iPhoneBridge contributors.
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+#ifndef TV_CLIENT_SEND_LOCKS_H
+#define TV_CLIENT_SEND_LOCKS_H
+
+#include <pthread.h>
+#include <rfb/rfb.h>
+#include <vector>
+
+// Keep the exact acquired clients alive until their send locks are released.
+// A second iterator would omit clients that disconnected and could include new
+// clients whose locks this capture never acquired.
+class TVClientSendLocks {
+public:
+    explicit TVClientSendLocks(rfbScreenInfoPtr screen) {
+        rfbClientIteratorPtr iterator = rfbGetClientIterator(screen);
+        try {
+            rfbClientPtr client;
+            while ((client = rfbClientIteratorNext(iterator))) {
+                // The iterator owns a temporary ref. Retain our own before it
+                // advances; LibVNC removes closed clients before waiting for
+                // their refs to reach zero and freeing their mutexes.
+                clients_.push_back(client);
+                rfbIncrClientRef(client);
+                pthread_mutex_lock(&client->sendMutex);
+            }
+        } catch (...) {
+            rfbReleaseClientIterator(iterator);
+            unlock();
+            throw;
+        }
+        rfbReleaseClientIterator(iterator);
+    }
+
+    TVClientSendLocks(const TVClientSendLocks &) = delete;
+    TVClientSendLocks &operator=(const TVClientSendLocks &) = delete;
+    ~TVClientSendLocks() { unlock(); }
+
+    void unlock() {
+        // Release all send locks before allowing any client teardown to run.
+        // Keep acquisition/release order identical to the original traversal.
+        for (rfbClientPtr client : clients_)
+            pthread_mutex_unlock(&client->sendMutex);
+        for (rfbClientPtr client : clients_)
+            rfbDecrClientRef(client);
+        clients_.clear();
+    }
+
+private:
+    std::vector<rfbClientPtr> clients_;
+};
+
+#endif
diff --git a/src/FrameUpdateRetry.h b/src/FrameUpdateRetry.h
new file mode 100644
index 0000000..9137bfa
--- /dev/null
+++ b/src/FrameUpdateRetry.h
@@ -0,0 +1,44 @@
+/*
+ * iPhoneBridge capture retry state, 2026-09-09.
+ * Copyright (c) 2026 iPhoneBridge contributors.
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+#ifndef TV_FRAME_UPDATE_RETRY_H
+#define TV_FRAME_UPDATE_RETRY_H
+
+#include <atomic>
+
+// One pending resnapshot, never a queue of old frames. The capture thread calls
+// deferCapture() then takeRetryIfReady(); client output threads call started()
+// and finished(). A true return requests a capture on the next display tick.
+class TVFrameUpdateRetry {
+public:
+    void started() { inflight_.fetch_add(1); }
+
+    bool finished(int limit) {
+        inflight_.fetch_sub(1);
+        return takeRetryIfReady(limit);
+    }
+
+    bool deferCapture(int limit) {
+        if (limit <= 0 || inflight_.load() < limit)
+            return false;
+        pending_.store(true);
+        return true;
+    }
+
+    bool takeRetryIfReady(int limit) {
+        // The capture-side recheck covers completion between the busy check
+        // and pending.store(). Sequential consistency ensures either this
+        // recheck or the completing client observes the retry obligation.
+        return (limit <= 0 || inflight_.load() < limit) && pending_.exchange(false);
+    }
+
+    int inflight() const { return inflight_.load(); }
+
+private:
+    std::atomic<int> inflight_{0};
+    std::atomic<bool> pending_{false};
+};
+
+#endif
