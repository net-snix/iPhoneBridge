             h *= 1099511628211ULL;
         }
         struct timeval tv;
         gettimeofday(&tv, NULL);
         h ^= (uint64_t)tv.tv_sec;
         h *= 1099511628211ULL;
         h ^= (uint64_t)tv.tv_usec;
         h *= 1099511628211ULL;
         sSeed = h;
     });
