@@ -0,0 +1,87 @@
+/*
+ * iPhoneBridge bounded capture scheduling, 2026-09-10.
+ * Copyright (c) 2026 iPhoneBridge contributors.
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+#ifndef TV_CAPTURE_SCHEDULE_H
+#define TV_CAPTURE_SCHEDULE_H
+
+#include <algorithm>
+#include <cstdint>
+#include <mutex>
+
+// Methods hold this mutex only while updating scalar state. No callbacks,
+// dispatch operations, capture work, or client locks execute under this mutex.
+class TVCaptureSchedule {
+public:
+    struct Plan { uint64_t generation; double delay; };
+
+    void start(double maximumFps) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        ++generation_;
+        active_ = true;
+        requested_ = wakeQueued_ = captured_ = false;
+        interval_ = 1.0 / std::max(1.0, maximumFps);
+    }
+
+    void stop() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        active_ = requested_ = wakeQueued_ = false;
+        ++generation_;
+    }
+
+    void setMaximumFps(double maximumFps) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        interval_ = 1.0 / std::max(1.0, maximumFps);
+    }
+
+    double period() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return interval_;
+    }
+
+    uint64_t request() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!active_) return 0;
+        requested_ = true;
+        return generation_;
+    }
+
+    Plan plan(double now) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!active_ || !requested_) return {0, 0};
+        return {generation_, captured_ ? std::max(0.0, lastStart_ + interval_ - now) : 0.0};
+    }
+
+    bool claimWake(uint64_t generation) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!active_ || generation != generation_ || !requested_ || wakeQueued_) return false;
+        wakeQueued_ = true;
+        return true;
+    }
+
+    bool takeWake(uint64_t generation) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!active_ || generation != generation_) return false;
+        wakeQueued_ = false;
+        return requested_;
+    }
+
+    bool beginCapture(uint64_t generation, double now) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!active_ || generation != generation_ || !requested_ ||
+            (captured_ && now < lastStart_ + interval_)) return false;
+        requested_ = false;
+        captured_ = true;
+        lastStart_ = now;
+        return true;
+    }
+
+private:
+    std::mutex mutex_;
+    uint64_t generation_ = 0;
+    bool active_ = false, requested_ = false, wakeQueued_ = false, captured_ = false;
+    double interval_ = 1.0 / 60.0, lastStart_ = 0;
+};
+
+#endif
diff --git a/src/ClientSendLocks.h b/src/ClientSendLocks.h
new file mode 100644
index 0000000..db56e2d
--- /dev/null
+++ b/src/ClientSendLocks.h
@@ -0,0 +1,51 @@
+/*
+ * iPhoneBridge framebuffer client locks, 2026-09-10.
+ * Copyright (c) 2026 iPhoneBridge contributors.
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+#ifndef TV_CLIENT_SEND_LOCKS_H
+#define TV_CLIENT_SEND_LOCKS_H
+
+#include <pthread.h>
+#include <rfb/rfb.h>
+
+// Never block the capture thread. The pinned LibVNC snapshot acquires every
+// client reference under its list mutex; its ordinary iterator cannot do this.
+// The caller separately serializes new-client acceptance with publication.
+class TVClientSendLocks {
+public:
+    explicit TVClientSendLocks(rfbScreenInfoPtr screen) {
+        if (!rfbGetClientSnapshot(screen, &clients_, &count_)) return;
+        for (; locked_ < count_; ++locked_) {
+            if (pthread_mutex_trylock(&clients_[locked_]->sendMutex) != 0) {
+                unlock();
+                return;
+            }
+        }
+        acquired_ = true;
+    }
+
+    TVClientSendLocks(const TVClientSendLocks &) = delete;
+    TVClientSendLocks &operator=(const TVClientSendLocks &) = delete;
+    ~TVClientSendLocks() { unlock(); }
+
+    bool acquired() const { return acquired_; }
+    size_t count() const { return count_; }
+
+    void unlock() {
+        // Unlock all clients before any reference drop can allow teardown.
+        for (size_t i = 0; i < locked_; ++i)
+            pthread_mutex_unlock(&clients_[i]->sendMutex);
+        rfbReleaseClientSnapshot(clients_, count_);
+        clients_ = nullptr;
+        count_ = locked_ = 0;
+        acquired_ = false;
+    }
+
+private:
+    rfbClientPtr *clients_ = nullptr;
+    size_t count_ = 0, locked_ = 0;
+    bool acquired_ = false;
+};
+
+#endif
diff --git a/src/FrameUpdateRetry.h b/src/FrameUpdateRetry.h
new file mode 100644
index 0000000..767a652
--- /dev/null
+++ b/src/FrameUpdateRetry.h
@@ -0,0 +1,76 @@
+/*
+ * iPhoneBridge bounded publication state, 2026-09-10.
+ * Copyright (c) 2026 iPhoneBridge contributors.
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+#ifndef TV_FRAME_UPDATE_RETRY_H
+#define TV_FRAME_UPDATE_RETRY_H
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+
+// Encoding completion requests one main-queue publication try, never a capture.
+// Main owns start/stop; a queued old-generation wake cannot publish a new session.
+// No callbacks, dispatch, frame work, or client locks run under this mutex.
+class TVFrameUpdateRetry {
+public:
+    void started() { inflight_.fetch_add(1); }
+    void finished() { inflight_.fetch_sub(1); }
+    int inflight() const { return inflight_.load(); }
+    bool capacityAvailable(int limit) const { return limit <= 0 || inflight() < limit; }
+
+    void start() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        ++generation_;
+        active_ = true;
+    }
+    void stop() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        ++generation_;
+        active_ = false;
+    }
+    bool active() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return active_;
+    }
+    uint64_t queuePublication() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!active_ || queuedGeneration_) return 0;
+        queuedGeneration_ = generation_;
+        return queuedGeneration_;
+    }
+    bool takePublication(uint64_t generation) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!generation || generation != queuedGeneration_) return false;
+        queuedGeneration_ = 0;
+        return active_ && generation == generation_;
+    }
+
+private:
+    std::atomic<int> inflight_{0};
+    std::mutex mutex_;
+    uint64_t generation_ = 0, queuedGeneration_ = 0;
+    bool active_ = false;
+};
+
+// Main-thread-only metadata for the existing back buffer. There is no frame
+// queue, client ownership, sample-buffer retention, or additional pixel storage.
+struct TVPreparedFrame {
+    bool valid = false;
+    bool forceFull = true;
+    bool fullHashes = false;
+    int rotation = 0;
+
+    void reset() { valid = false; forceFull = true; fullHashes = false; rotation = 0; }
+    void beginOverwrite() { valid = false; fullHashes = false; }
+    void prepared(int rotQ, bool force, bool hashed) {
+        rotation = rotQ;
+        forceFull = forceFull || force;
+        fullHashes = hashed;
+        valid = true;
+    }
+    void published() { valid = false; forceFull = false; fullHashes = false; }
+};
+
+#endif
