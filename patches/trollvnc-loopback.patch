new file mode 100644
index 0000000..a9b6541
--- /dev/null
+++ b/src/CaptureGovernor.h
@@ -0,0 +1,134 @@
+/*
+ * iPhoneBridge capture-rate governor, 2026-09-12.
+ * Copyright (c) 2026 iPhoneBridge contributors.
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Why this exists
+ * ---------------
+ * Capture runs on the display link at the configured ceiling (60 fps) even when
+ * encoding cannot absorb that rate. Each over-driven tick still pays for
+ * CARenderServerRenderDisplay, the IOSurfaceAccelerator transfer and the
+ * rotate/scale/hash preparation, then the prepared frame is discarded because
+ * the encoder still holds the only in-flight slot. Measured on a warm phone,
+ * ~20 of ~53 captures per second were discarded that way.
+ *
+ * That waste is self-reinforcing: discarded captures are pure heat, heat moves
+ * the daemon's threads onto efficiency cores at reduced clocks, slower encoding
+ * discards more captures. Pacing capture to the rate the encoder actually
+ * sustains removes the wasted work and turns the loop negative.
+ *
+ * Signals (both counted without blocking the capture or output threads):
+ *  - completed(): one framebuffer update finished encoding and sending.
+ *  - blocked():   a prepared frame could not be published because no in-flight
+ *                 capacity was available. This is the over-drive signal.
+ *
+ * A static screen produces neither signal, so the ceiling is restored rather
+ * than clamped to an idle rate.
+ */
+#ifndef TV_CAPTURE_GOVERNOR_H
+#define TV_CAPTURE_GOVERNOR_H
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+
+class TVCaptureGovernor {
+public:
+    // Evaluation cadence and the window each decision observes.
+    static constexpr double kEvaluateInterval = 0.5;
+    // Never pace below this; the mirror must stay usable while hot.
+    static constexpr double kFloorFps = 20.0;
+    // Asymmetric response. The limit being tracked is thermal, so it moves on a
+    // multi-second time constant: shedding load briefly restores headroom that
+    // disappears again once the heat returns. A symmetric controller therefore
+    // rides that recovery straight back into over-drive and oscillates. Back off
+    // immediately on evidence, and probe upward only after a sustained clean
+    // period, one small step at a time.
+    static constexpr double kRecoverStepFps = 2.0;
+    static constexpr uint32_t kCleanWindowsBeforeRaise = 20; // 10 s at 0.5 s
+    // Apply only changes worth a display-link reconfiguration.
+    static constexpr double kApplyEpsilonFps = 1.5;
+
+    // A ceiling of zero or less disables pacing entirely; evaluate() then never
+    // reports a change and capture keeps the configured display-link rate.
+    void configure(double ceilingFps) {
+        ceiling_ = (ceilingFps > 0) ? ceilingFps : 0.0;
+        current_ = ceiling_;
+        windowOpen_ = false;
+        cleanWindows_ = 0;
+        completed_.store(0, std::memory_order_relaxed);
+        blocked_.store(0, std::memory_order_relaxed);
+    }
+
+    // Main thread, on capture session start. Returns to the ceiling so a new
+    // session is never inherited at a previous session's paced rate.
+    void reset() {
+        current_ = ceiling_;
+        windowOpen_ = false;
+        cleanWindows_ = 0;
+        completed_.store(0, std::memory_order_relaxed);
+        blocked_.store(0, std::memory_order_relaxed);
+    }
+
+    // Output thread. Counting only; no locks and no reconfiguration here.
+    void completed() { completed_.fetch_add(1, std::memory_order_relaxed); }
+
+    // Main thread, from the publication path when capacity was unavailable.
+    void blocked() { blocked_.fetch_add(1, std::memory_order_relaxed); }
+
+    double ceiling() const { return ceiling_; }
+    double current() const { return current_; }
+
+    // Main thread, once per display-link tick. Returns true when the caller
+    // should apply `fpsOut` to the display link and capture schedule.
+    bool evaluate(double now, double *fpsOut) {
+        if (ceiling_ <= 0) return false;
+        if (!windowOpen_) {
+            windowOpen_ = true;
+            windowStart_ = now;
+            return false;
+        }
+        double elapsed = now - windowStart_;
+        if (elapsed < kEvaluateInterval) return false;
+
+        uint32_t completed = completed_.exchange(0, std::memory_order_relaxed);
+        uint32_t blocked = blocked_.exchange(0, std::memory_order_relaxed);
+        windowStart_ = now;
+        if (elapsed <= 0) return false;
+
+        double deliveredFps = (double)completed / elapsed;
+        double target;
+        if (blocked > 0) {
+            // Over-driving: pace to what the pipeline actually sustained. No
+            // headroom is added; anything above the measured rate re-blocks and
+            // spends the capture budget on frames that will be discarded.
+            cleanWindows_ = 0;
+            target = deliveredFps;
+        } else if (++cleanWindows_ >= kCleanWindowsBeforeRaise) {
+            // Sustained clean period: probe one small step toward the ceiling so
+            // a phone that has actually cooled recovers.
+            cleanWindows_ = 0;
+            target = current_ + kRecoverStepFps;
+        } else {
+            return false;
+        }
+        target = std::min(ceiling_, std::max(kFloorFps, target));
+
+        if (std::fabs(target - current_) < kApplyEpsilonFps) return false;
+        current_ = target;
+        *fpsOut = current_;
+        return true;
+    }
+
+private:
+    std::atomic<uint32_t> completed_{0};
+    std::atomic<uint32_t> blocked_{0};
+    double ceiling_ = 60.0;
+    double current_ = 60.0;
+    double windowStart_ = 0;
+    bool windowOpen_ = false;
+    uint32_t cleanWindows_ = 0;
+};
+
+#endif
