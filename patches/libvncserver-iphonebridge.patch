 /* hang up on all clients and free all reserved memory */
diff --git a/src/libvncserver/rfbserver.c b/src/libvncserver/rfbserver.c
index 5cb4265..d2ad37d 100644
--- a/src/libvncserver/rfbserver.c
+++ b/src/libvncserver/rfbserver.c
@@ -234,11 +234,54 @@ void
 rfbReleaseClientIterator(rfbClientIteratorPtr iterator)
 {
   if(iterator && iterator->next) rfbDecrClientRef(iterator->next);
   free(iterator);
 }
 
+rfbBool
+rfbGetClientSnapshot(rfbScreenInfoPtr screen,
+                     rfbClientPtr **clients, size_t *count)
+{
+  rfbClientPtr cl, *snapshot = NULL;
+  size_t length = 0, index = 0;
+
+  *clients = NULL;
+  *count = 0;
+  LOCK(rfbClientListMutex);
+  for (cl = screen->clientHead; cl; cl = cl->next) {
+    if (length == (size_t)-1 / sizeof(*snapshot)) {
+      UNLOCK(rfbClientListMutex);
+      return FALSE;
+    }
+    ++length;
+  }
+  if (length) {
+    snapshot = malloc(length * sizeof(*snapshot));
+    if (!snapshot) {
+      UNLOCK(rfbClientListMutex);
+      return FALSE;
+    }
+    for (cl = screen->clientHead; cl; cl = cl->next) {
+      rfbIncrClientRef(cl);
+      snapshot[index++] = cl;
+    }
+  }
+  UNLOCK(rfbClientListMutex);
+  *clients = snapshot;
+  *count = length;
+  return TRUE;
+}
+
+void
+rfbReleaseClientSnapshot(rfbClientPtr *clients, size_t count)
+{
+  size_t index;
+  for (index = 0; index < count; ++index)
+    rfbDecrClientRef(clients[index]);
+  free(clients);
+}
+
 
