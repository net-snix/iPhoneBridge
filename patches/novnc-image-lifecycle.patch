diff --git a/core/image-context.js b/core/image-context.js
new file mode 100644
index 0000000..a5bd1e3
--- /dev/null
+++ b/core/image-context.js
@@ -0,0 +1,132 @@
+/*
+ * iPhoneBridge: bounded document ownership for native image decoding.
+ * Licensed under MPL 2.0 (see LICENSE.txt).
+ */
+
+const MAX_IMAGE_JOBS = 4096;
+
+// WebKit's DocumentLoader retains each notified resource URL for its lifetime:
+// https://github.com/WebKit/WebKit/blob/b5f0255e3ed796abfd39614950fe8e2ab2a223e8/Source/WebCore/loader/DocumentLoader.h
+// Revoke/dispose cannot clear that history. Bound it with an owned document,
+// while keeping the same native decoder and the viewer/RFB session alive.
+// Remove this owner once supported WebKit versions bound that URL history and
+// the unchanged decoder passes the native long-running memory/cadence check.
+export default class ImageDecodeContext {
+    constructor(document) {
+        if (!document || typeof document.createElement !== 'function') {
+            throw new Error("Image decode context requires an owner document");
+        }
+        this._document = document;
+        this._current = null;
+        this._waiters = new Set();
+        this._abort = new AbortController();
+        this._error = null;
+        this._pumping = false;
+    }
+
+    acquire(signal) {
+        if (this._error !== null) { return Promise.reject(this._error); }
+        if (signal?.aborted) { return Promise.reject(signal.reason); }
+        return new Promise((resolve, reject) => {
+            const waiter = { resolve, reject, signal, abort: null };
+            waiter.abort = () => {
+                if (!this._waiters.has(waiter)) { return; }
+                this._removeWaiter(waiter);
+                reject(signal.reason);
+                this._pump();
+            };
+            this._waiters.add(waiter);
+            signal?.addEventListener('abort', waiter.abort, { once: true });
+            this._pump();
+        });
+    }
+
+    _removeWaiter(waiter) {
+        this._waiters.delete(waiter);
+        waiter.signal?.removeEventListener('abort', waiter.abort);
+    }
+
+    _createDocument() {
+        const frame = this._document.createElement('iframe');
+        try {
+            frame.hidden = true;
+            frame.setAttribute('aria-hidden', 'true');
+            frame.tabIndex = -1;
+            // The initial about:blank document becomes active and same-origin
+            // on attachment. Setting src would cause an extra navigation.
+            this._document.body.appendChild(frame);
+            if (this._error !== null) { throw this._error; }
+            const document = frame.contentDocument;
+            if (!document) { throw new Error("Image decoder document is unavailable"); }
+            this._current = { frame, document, uses: 0, active: 0 };
+        } catch (error) {
+            frame.remove();
+            throw error;
+        }
+    }
+
+    _removeDocument() {
+        const current = this._current;
+        if (current === null) { return; }
+        this._current = null;
+        const frame = current.frame;
+        current.frame = current.document = null;
+        frame.remove();
+    }
+
+    _lease() {
+        let owner = this, current = this._current;
+        current.uses++;
+        current.active++;
+        return {
+            document: current.document,
+            signal: this._abort.signal,
+            release() {
+                if (owner === null) { return; }
+                const releasedOwner = owner;
+                owner = null;
+                current.active--;
+                current = null;
+                this.document = this.signal = null;
+                releasedOwner._pump();
+            },
+        };
+    }
+
+    _pump() {
+        if (this._pumping || this._error !== null) { return; }
+        this._pumping = true;
+        try {
+            while (this._error === null) {
+                if (this._current?.uses === MAX_IMAGE_JOBS) {
+                    if (this._current.active !== 0) { break; }
+                    this._removeDocument();
+                }
+                if (this._waiters.size === 0 || this._error !== null) { break; }
+                if (this._current === null) { this._createDocument(); }
+                if (this._waiters.size === 0 || this._error !== null) { continue; }
+                const waiter = this._waiters.values().next().value;
+                this._removeWaiter(waiter);
+                waiter.resolve(this._lease());
+            }
+        } catch (error) {
+            this.dispose(error);
+        } finally {
+            this._pumping = false;
+        }
+    }
+
+    dispose(error = new Error("Image decode context disposed")) {
+        if (this._error !== null) { return; }
+        this._error = error;
+        for (const waiter of this._waiters) {
+            this._removeWaiter(waiter);
+            waiter.reject(error);
+        }
+        // Active resources synchronously clear their sources before the frame
+        // is removed. Already resolved admissions also observe this signal.
+        this._abort.abort(error);
+        this._removeDocument();
+        this._document = null;
+    }
+}
diff --git a/core/image-resource.js b/core/image-resource.js
new file mode 100644
index 0000000..916ee9e
--- /dev/null
+++ b/core/image-resource.js
@@ -0,0 +1,155 @@
+/*
+ * iPhoneBridge: bounded lifetime for encoded image rectangles.
+ * Licensed under MPL 2.0, like the surrounding noVNC display code.
+ */
+
+const DECODE_TIMEOUT = 10000;
+
+export default class ImageResource {
+    constructor(data, mime, width, height, onReady, onError, context) {
+        if (!context || typeof context.acquire !== 'function') {
+            throw new Error("Image rectangle requires a decode context");
+        }
+        this.image = null;
+        this._sourceImage = null;
+        this._context = context;
+        this._lease = null;
+        this._admission = null;
+        this._contextFailed = null;
+        this.ready = false;
+        this._disposed = false;
+        this._decoding = false;
+        this._width = width;
+        this._height = height;
+        this._onReady = onReady;
+        this._onError = onError;
+        this._timer = null;
+        // Blob snapshots the socket bytes before its receive buffer is reused.
+        // Decode through HTMLImageElement, then give the queue a closeable
+        // bitmap. Passing the element (not the Blob) avoids WebKit's separate
+        // FileReaderLoader path and its internal temporary object URL.
+        const bytes = ArrayBuffer.isView(data) ?
+            new Uint8Array(data.buffer, data.byteOffset, data.byteLength) : new Uint8Array(data);
+        this._blob = new Blob([bytes], { type: mime });
+        this._url = null;
+        this._loaded = this._handleLoad.bind(this);
+        this._failed = () => this._fail(new Error("Image rectangle failed to decode"));
+    }
+
+    start() {
+        if (this._disposed || this._timer !== null || this.ready) { return; }
+        this._admission = new AbortController();
+        this._timer = setTimeout(() => {
+            this._fail(new Error("Image rectangle decode timed out"));
+        }, DECODE_TIMEOUT);
+        try {
+            this._context.acquire(this._admission.signal)
+                .then(lease => this._beginDecode(lease))
+                .catch(error => this._fail(error));
+        } catch (error) {
+            this._fail(error);
+        }
+    }
+
+    _beginDecode(lease) {
+        if (this._disposed) { lease.release(); return; }
+        if (lease.signal.aborted) {
+            const error = lease.signal.reason;
+            lease.release();
+            this._fail(error);
+            return;
+        }
+        this._lease = lease;
+        this._context = this._admission = null;
+        const signal = lease.signal;
+        this._contextFailed = () => this._fail(signal.reason);
+        signal.addEventListener('abort', this._contextFailed, { once: true });
+        this._sourceImage = lease.document.createElement('img');
+        this._sourceImage.addEventListener('load', this._loaded);
+        this._sourceImage.addEventListener('error', this._failed);
+        this._url = URL.createObjectURL(this._blob);
+        this._blob = null;
+        this._sourceImage.src = this._url;
+    }
+
+    _handleLoad() {
+        if (this._disposed || this._decoding || this._sourceImage === null) { return; }
+        if (this._sourceImage.naturalWidth !== this._width ||
+            this._sourceImage.naturalHeight !== this._height) {
+            this._fail(new Error("Decoded image has incorrect dimensions. Got " +
+                                 this._sourceImage.naturalWidth + "x" + this._sourceImage.naturalHeight +
+                                 ". Expected " + this._width + "x" + this._height + "."));
+            return;
+        }
+        this._decoding = true;
+        this._removeListeners();
+        try {
+            // Default orientation, color conversion and alpha handling; no
+            // resizing or alternate decoder. Keep the source until resolved.
+            createImageBitmap(this._sourceImage).then(bitmap => {
+                if (this._disposed) {
+                    bitmap.close();
+                    return;
+                }
+                this.image = bitmap;
+                if (bitmap.width !== this._width || bitmap.height !== this._height) {
+                    this._fail(new Error("Decoded bitmap has incorrect dimensions. Got " +
+                                         bitmap.width + "x" + bitmap.height + ". Expected " +
+                                         this._width + "x" + this._height + "."));
+                    return;
+                }
+                this._releaseSource();
+                this.ready = true;
+                this._clearTimer();
+                this._onReady();
+            }).catch(error => this._fail(error));
+        } catch (error) {
+            this._fail(error);
+        }
+    }
+
+    _clearTimer() {
+        clearTimeout(this._timer);
+        this._timer = null;
+    }
+
+    _removeListeners() {
+        if (this._sourceImage === null) { return; }
+        this._sourceImage.removeEventListener('load', this._loaded);
+        this._sourceImage.removeEventListener('error', this._failed);
+    }
+
+    _releaseSource() {
+        this._removeListeners();
+        const source = this._sourceImage, url = this._url, lease = this._lease;
+        const admission = this._admission, contextFailed = this._contextFailed;
+        this._sourceImage = this._url = this._lease = this._admission = null;
+        this._blob = this._context = this._contextFailed = null;
+        this._loaded = this._failed = null;
+        lease?.signal.removeEventListener('abort', contextFailed);
+        try {
+            source?.removeAttribute('src');
+        } finally {
+            if (url !== null) { URL.revokeObjectURL(url); }
+            admission?.abort(new Error("Image rectangle admission cancelled"));
+            lease?.release();
+        }
+    }
+
+    _fail(error) {
+        if (this._disposed || this.ready) { return; }
+        const onError = this._onError;
+        this.dispose();
+        onError(error);
+    }
+
+    dispose() {
+        if (this._disposed) { return; }
+        this._disposed = true;
+        this._clearTimer();
+        this._releaseSource();
+        if (this.image !== null) { this.image.close(); }
+        this.image = null;
+        this._onReady = this._onError = null;
+    }
+}
