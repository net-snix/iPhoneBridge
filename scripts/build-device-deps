#!/usr/bin/env python3
"""Build the native iOS daemon from reviewed local source; never access a device.

Offline: --source-package <extracted device source directory>. Apple SDK, Theos
and ldid are platform/toolchain prerequisites. No codec/vendor binaries are used.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess

ROOT = Path(__file__).resolve().parents[1]


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def source_files(tree):
    tree = Path(tree)
    paths = [path for path in sorted(tree.rglob('*'))
             if path.relative_to(tree).parts[0] not in ('.theos', 'packages')]
    if any(path.is_symlink() for path in paths):
        raise RuntimeError(f'Source inventory contains a symlink: {tree}')
    return {str(path.relative_to(tree)): sha(path)
            for path in paths if path.is_file()}


def source_tree_sha(files):
    return hashlib.sha256(json.dumps(files, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def output(*args, cwd=None):
    return subprocess.check_output([str(x) for x in args], cwd=cwd).decode().strip()


def verify_retained_sources(device, lock):
    for name, expected in lock['retained_files_sha256'].items():
        if sha(device / name) != expected:
            raise RuntimeError(f'Retained source bytes differ from their provenance pin: {name}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-dir', type=Path)
    parser.add_argument('--source-package', type=Path)
    parser.add_argument('--theos', type=Path)
    parser.add_argument('--jobs', type=int, default=4)
    args = parser.parse_args()
    if args.jobs < 1 or args.jobs > 32:
        parser.error('--jobs must be 1..32')
    base = args.source_package.resolve() if args.source_package else ROOT
    project = json.loads((base / 'dependency-lock.json').read_text())
    lock = json.loads((base / 'device-sources.lock.json').read_text())
    device = base / 'device'
    helper = base / ('device-session.sh' if args.source_package else 'iphonebridge/device-session.sh')
    helper_hash = sha(helper)
    verify_retained_sources(device, lock)
    files = source_files(device)
    tree_hash = source_tree_sha(files)
    recipe_hash = sha(Path(__file__))
    if args.source_package:
        released = json.loads((base / 'build-manifest.json').read_text())
        if (released.get('schema_version') != 1 or released.get('source', {}).get('kind') != 'native'
                or released.get('build_recipe_sha256') != recipe_hash or released.get('device_sources') != lock
                or released.get('script_sha256') != helper_hash
                or released.get('toolchain', {}).get('theos_commit') != project['theos']['commit']
                or released.get('toolchain', {}).get('sdk') != project['theos']['sdk']):
            raise RuntimeError('Source package recipe, helper, lock or toolchain differs from its manifest')
        source_commit = released['source']['commit']
        if released['source']['files_sha256'] != files or released['source']['tree_sha256'] != tree_hash:
            raise RuntimeError('Source package differs from the released device manifest')
    else:
        source_commit = output('git', '-C', ROOT, 'rev-parse', 'HEAD')
    theos = (args.theos or Path(os.environ.get('THEOS', project['theos']['path']))).expanduser().resolve()
    sdk = theos / 'sdks' / project['theos']['sdk']
    if not sdk.is_dir():
        raise RuntimeError(f'Pinned SDK is missing: {sdk}')
    if output('git', '-C', theos, 'rev-parse', 'HEAD') != project['theos']['commit']:
        raise RuntimeError('Theos differs from the pinned revision')
    identity = {'tree': tree_hash, 'recipe': recipe_hash, 'sources': lock, 'toolchain': project['theos']}
    key = source_tree_sha(identity)[:12]
    work = (args.build_dir or ROOT / 'work' / f'device-build-{key}').resolve()
    compiled = work / 'device'
    if compiled.exists():
        if source_files(compiled) != files:
            raise RuntimeError(f'Build directory contains a different source recipe: {compiled}; choose a new directory')
    else:
        compiled.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(device, compiled)
    source_maps = f'-ffile-prefix-map={work}=/usr/src/iphonebridge -ffile-prefix-map={theos}=/opt/theos'
    command = ['make', '-B', f'-j{args.jobs}', 'all', f'THEOS={theos}',
               f'ADDITIONAL_CFLAGS={source_maps}', 'THEOS_PACKAGE_SCHEME=rootless',
               'FINALPACKAGE=1', 'SUBPROJECTS=']
    subprocess.run(command, cwd=compiled, check=True)
    binary = compiled / '.theos/obj/trollvncserver'
    undefined = output('nm', '-u', binary)
    if any(symbol in undefined for symbol in ('_rfb', '_tjCompress', '_jpeg_', '_png_', '_lzo_', '_SSL_', '_sasl_')):
        raise RuntimeError('Legacy runtime symbols remain in the native daemon')
    libraries = output('otool', '-L', binary)
    for line in libraries.splitlines()[1:]:
        library = line.strip().split(' ', 1)[0]
        if not library.startswith(('/System/Library/', '/usr/lib/')):
            raise RuntimeError(f'Non-platform runtime dependency: {library}')
    if (source_files(device) != files or source_files(compiled) != files
            or sha(Path(__file__)) != recipe_hash or sha(helper) != helper_hash):
        raise RuntimeError('Source recipe changed during compilation; rebuild before staging')
    manifest = {
        'schema_version': 1,
        'binary': {'path': str(binary), 'sha256': sha(binary)},
        'script_sha256': helper_hash,
        'source': {'kind': 'native', 'path': str(compiled), 'commit': source_commit,
                   'tree_sha256': tree_hash, 'files_sha256': files},
        'static_libraries': {}, 'device_sources': lock, 'build_recipe_sha256': recipe_hash,
        'supply_chain': 'Native GPL daemon built from inventoried local source and pinned TrollVNC-derived inputs; only Apple platform libraries linked.',
        'toolchain': {'theos_path': str(theos), 'theos_commit': project['theos']['commit'],
                      'sdk_path': str(sdk), 'xcode': output('xcodebuild', '-version')},
        'build_command': command, 'linked_libraries': libraries.splitlines()[1:],
    }
    (work / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    if not args.source_package:
        (ROOT / 'work').mkdir(exist_ok=True)
        (ROOT / 'work/build-manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    print(f'Source-built native daemon: {binary}\nSHA-256: {sha(binary)}')


if __name__ == '__main__':
    main()
