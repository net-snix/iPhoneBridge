#!/usr/bin/env python3
"""Stage the verified native device payload and complete corresponding source."""
import argparse
import hashlib
import json
from pathlib import Path
import runpy
import shutil
import subprocess

ROOT = Path(__file__).resolve().parents[1]


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def verify_build_provenance(build, project, source_lock, root):
    """Verify the binary against every native build input before staging."""
    if build.get("schema_version") != 1 or build.get("source", {}).get("kind") != "native":
        raise RuntimeError("Expected a native device build manifest; rebuild before staging")
    source = build["source"]
    commit = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip()
    if source.get("commit") != commit:
        raise RuntimeError("Device source commit differs from project HEAD; rebuild before staging")
    recipe = root / "scripts/build-device-deps"
    if build.get("build_recipe_sha256") != sha(recipe):
        raise RuntimeError("Rebuild using the current recipe before staging")
    if build.get("device_sources") != source_lock:
        raise RuntimeError("Device build does not match the current source lock")
    if build.get("static_libraries") != {}:
        raise RuntimeError("Native daemon must not contain non-platform static libraries")
    helpers = runpy.run_path(str(recipe))
    files = source.get("files_sha256")
    if not isinstance(files, dict) or not files:
        raise RuntimeError("Missing native source inventory; rebuild before staging")
    if source.get("tree_sha256") != helpers["source_tree_sha"](files):
        raise RuntimeError("Native source tree hash differs from its inventory")
    for tree, label in ((root / "device", "Current"), (Path(source.get("path", "")), "Compiled")):
        if not tree.is_dir() or helpers["source_files"](tree) != files:
            raise RuntimeError(f"{label} native source differs from the compiled inventory; rebuild before staging")
        helpers["verify_retained_sources"](tree, source_lock)
    toolchain = build.get("toolchain", {})
    if toolchain.get("theos_commit") != project["theos"]["commit"]:
        raise RuntimeError("Device build uses a different Theos revision; rebuild before staging")
    sdk = toolchain.get("sdk_path")
    if not isinstance(sdk, str) or Path(sdk).name != project["theos"]["sdk"]:
        raise RuntimeError("Device build uses a different SDK; rebuild before staging")
    binary = Path(build.get("binary", {}).get("path", ""))
    if not binary.is_file() or sha(binary) != build["binary"].get("sha256"):
        raise RuntimeError("Device binary differs from its build manifest; rebuild before staging")
    helper = root / "iphonebridge/device-session.sh"
    if build.get("script_sha256") != sha(helper):
        raise RuntimeError("Device session script differs from its build manifest; rebuild before staging")


def stage(build_path, payload, source, root=ROOT):
    payload, source = payload.resolve(), source.resolve()
    if payload.is_relative_to(source) or source.is_relative_to(payload):
        raise RuntimeError("Payload and corresponding-source directories must be separate")
    build = json.loads(build_path.read_text())
    project = json.loads((root / "dependency-lock.json").read_text())
    source_lock = json.loads((root / "device-sources.lock.json").read_text())
    verify_build_provenance(build, project, source_lock, root)
    for folder in (payload, source):
        if folder.exists():
            raise RuntimeError(f"Staging target already exists; choose a fresh output directory: {folder}")
    binary = Path(build["binary"]["path"])
    helper = root / "iphonebridge/device-session.sh"
    payload.mkdir(parents=True)
    source.mkdir(parents=True)
    shutil.copy2(binary, payload / "trollvncserver")
    shutil.copy2(helper, payload / helper.name)
    manifest = {
        "schema_version": 1,
        "binary": {"sha256": build["binary"]["sha256"]},
        "script_sha256": build["script_sha256"],
        "source": {key: value for key, value in build["source"].items() if key != "path"},
        "static_libraries": {}, "device_sources": source_lock,
        "build_recipe_sha256": build["build_recipe_sha256"],
        "supply_chain": build["supply_chain"],
        "toolchain": {"theos_commit": build["toolchain"]["theos_commit"],
                      "sdk": Path(build["toolchain"]["sdk_path"]).name,
                      "xcode": build["toolchain"]["xcode"]},
    }
    (payload / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    for name in build["source"]["files_sha256"]:
        target = source / "device" / name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(Path(build["source"]["path"]) / name, target)
    for name in ("dependency-lock.json", "device-sources.lock.json", "LICENSE", "THIRD_PARTY.md"):
        shutil.copy2(root / name, source / name)
    (source / "scripts").mkdir()
    shutil.copy2(root / "scripts/build-device-deps", source / "scripts/build-device-deps")
    shutil.copy2(helper, source / helper.name)
    shutil.copy2(payload / "manifest.json", source / "build-manifest.json")
    (source / "README.md").write_text("""# Native device daemon corresponding source

`device/` contains the complete source, private API declarations, Makefile,
entitlements and retained GPL notices used to compile this release. The native
daemon links Apple platform frameworks only; no third-party binary library or
source download is required. `device-sources.lock.json` records retained source
provenance. `build-manifest.json` records the exact source inventory, project
commit, build recipe, toolchain and artifact hash.

## Rebuild offline

Prerequisites: macOS, Python 3.12+, Xcode command-line tools, and Theos at the
revision in `dependency-lock.json` with its pinned iPhoneOS16.5 SDK. Apple SDKs,
system frameworks and compiler tooling are platform prerequisites and are not
redistributed.

From this directory, run:

```sh
python3 scripts/build-device-deps --source-package . --theos /path/to/theos --build-dir /tmp/iphonebridge-native-build
```

The builder reports the daemon path and writes a build manifest inside the build
directory. It does not contact, install on, launch on or stop the phone. The
bundled `device-session.sh` is the installation and lifecycle helper used by the
app. Rebuilding with a different toolchain need not produce identical bytes.

The device daemon and retained TrollVNC-derived source are GPL-2.0-only. Read
`device/README.md`, `device/vendor/COPYING` and `THIRD_PARTY.md` for provenance
and notices. The project build/control scripts use the included MIT license.
""")
    # Catch an edit racing staging, then verify the copied payload and source too.
    verify_build_provenance(build, project, source_lock, root)
    if sha(payload / "trollvncserver") != manifest["binary"]["sha256"] or sha(payload / helper.name) != manifest["script_sha256"]:
        raise RuntimeError("Device payload changed while staging")
    if (sha(source / "scripts/build-device-deps") != manifest["build_recipe_sha256"]
            or sha(source / helper.name) != manifest["script_sha256"]
            or json.loads((source / "device-sources.lock.json").read_text()) != source_lock
            or json.loads((source / "dependency-lock.json").read_text()) != project):
        raise RuntimeError("Corresponding build inputs changed while staging")
    helpers = runpy.run_path(str(source / "scripts/build-device-deps"))
    if helpers["source_files"](source / "device") != manifest["source"]["files_sha256"]:
        raise RuntimeError("Corresponding device source changed while staging")
    sums = {path.relative_to(source).as_posix(): sha(path)
            for path in sorted(source.rglob("*")) if path.is_file()}
    (source / "SHA256SUMS.json").write_text(json.dumps(sums, indent=2) + "\n")
    return manifest


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--build-manifest", type=Path, default=ROOT / "work/build-manifest.json")
    parser.add_argument("--payload-dir", type=Path, default=ROOT / "work/device-release")
    parser.add_argument("--source-dir", type=Path, default=ROOT / "work/release-sources/device")
    args = parser.parse_args()
    stage(args.build_manifest, args.payload_dir, args.source_dir)
    print(f"Device payload: {args.payload_dir}\nCorresponding source: {args.source_dir}")


if __name__ == "__main__":
    main()
