#!/usr/bin/env python3
"""Check final-frame delivery during a deliberately slow, read-only RAW capture.

Requires the disposable latency fixture in INPUT mode, with background NONE.
Sends one Space, then a recovery Space, only after recognizing that fixture's
barcode. Uses the selected phone's direct USB screenshot as independent evidence.
All evidence stays in the specified local output directory. No server changes.
"""
import argparse
from contextlib import closing
import io
import json
from pathlib import Path
import socket
import struct
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from PIL import Image  # noqa: E402
from iphonebridge import control  # noqa: E402

COLORS = [(16, 16, 16), (240, 240, 240), (255, 48, 48), (48, 255, 48),
          (48, 48, 255), (48, 255, 255), (255, 255, 48), (255, 48, 255), (255, 144, 48)]
MARKERS = {0: 2, 1: 3, 2: 4, 3: 5, 36: 6, 37: 7, 38: 5, 39: 8}


def barcode(png):
    with Image.open(io.BytesIO(png)) as opened:
        image = opened.convert("RGB")
    def classify(pixel):
        distances = [sum((a-b)**2 for a, b in zip(pixel, color)) for color in COLORS]
        best = min(range(len(distances)), key=distances.__getitem__)
        return best if distances[best] < 11026 else -1
    # The fixture barcode is near the top; never match arbitrary body content.
    for y in range(150, min(image.height, 450), 12):
        row = [classify(image.getpixel((x, y))) for x in range(image.width)]
        runs = []
        for x, color in enumerate(row):
            if not runs or runs[-1][0] != color:
                runs.append([color, x, x+1])
            else:
                runs[-1][2] = x+1
        for i in range(len(runs)-3):
            header = runs[i:i+4]
            if [r[0] for r in header] != [2, 3, 4, 5]:
                continue
            start = header[0][1]
            pitch = (header[-1][2]-start)/4
            positions = [round(start+(c+0.5)*pitch) for c in range(40)]
            if pitch < 3 or max(positions) >= image.width:
                continue
            cells = [row[x] for x in positions]
            if any(cells[c] != color for c, color in MARKERS.items()):
                continue
            if any(bit not in (0, 1) for bit in cells[4:36]):
                continue
            value = 0
            for bit in cells[4:36]:
                value = value*2+bit
            return value
    raise RuntimeError("No fixture barcode recognized; do not send input")


def recv(sock, count):
    data = bytearray()
    while len(data) < count:
        chunk = sock.recv(min(count-len(data), 65536))
        if not chunk:
            raise RuntimeError("RFB connection closed")
        data.extend(chunk)
    return bytes(data)


def connect_raw():
    sock = socket.socket()
    sock.settimeout(5)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 8192)
    try:
        sock.connect(("127.0.0.1", 15901))
        assert recv(sock, 12) == b"RFB 003.008\n"
        sock.sendall(b"RFB 003.008\n")
        options = recv(sock, recv(sock, 1)[0])
        assert 1 in options
        sock.sendall(b"\x01")
        assert recv(sock, 4) == b"\0\0\0\0"
        sock.sendall(b"\x01")
        init = recv(sock, 24)
        width, height = struct.unpack("!HH", init[:4])
        assert init[4] == 32
        name_len = struct.unpack("!I", init[20:])[0]
        assert name_len < 4096
        recv(sock, name_len)
        sock.sendall(struct.pack("!BBHi", 2, 0, 1, 0))
        return sock, (width, height)
    except BaseException:
        sock.close()
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument("--usb-tool", type=Path, required=True)
    parser.add_argument("--data-dir", type=Path, required=True)
    args = parser.parse_args()
    args.output_dir.mkdir(parents=True, exist_ok=True)
    state = json.loads((args.data_dir / "state.json").read_text())
    direct = args.output_dir / "direct.png"
    report = {"timestamp_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    with control._session() as session:
        png, size = session.frame()
        initial = barcode(png)
        assert initial < 0x80000000, "Animation mode: no input sent"
        time.sleep(0.2)
        assert barcode(session.frame()[0]) == initial, "Unstable fixture: no input sent"
        raw, raw_size = connect_raw()
        with closing(raw):
            assert raw_size == size
            raw.sendall(struct.pack("!BBHHHH", 3, 0, 0, 0, *size))
            header = recv(raw, 4)
            assert header[0] == 0 and struct.unpack("!H", header[2:])[0] == 1
            x, y, width, height, encoding = struct.unpack("!HHHHi", recv(raw, 12))
            assert (x, y, width, height, encoding) == (0, 0, *size, 0)
            # Hold the RAW reader to keep one server update in flight. The
            # other warm client sends input; every key is released in finally.
            control._press(session, " ")
            time.sleep(0.4)
            recv(raw, width*height*4)
        time.sleep(0.25)
        captured = session.frame()[0]
        (args.output_dir / "rfb.png").write_bytes(captured)
        observed = barcode(captured)
        subprocess.run([str(args.usb_tool), "-u", state["connection"]["udid"], str(direct)],
                       check=True, capture_output=True, timeout=15)
        physical = barcode(direct.read_bytes())
        report.update(initial=initial, expected=initial+1, rfb_observed=observed,
                      direct_usb_observed=physical, held_reader_ms=400,
                      mismatch=physical == initial+1 and observed != physical)
        if physical != initial+1:
            (args.output_dir / "result.json").write_text(json.dumps(report, indent=2))
            raise RuntimeError("Input outcome differs from expectation; no further input sent")
        time.sleep(1)
        report["rfb_after_extra_second"] = barcode(session.frame()[0])
        # Resolve the test's final state with a new, idle update, then verify.
        control._press(session, " ")
        time.sleep(0.25)
        report["recovery_rfb_observed"] = barcode(session.frame()[0])
        assert report["recovery_rfb_observed"] == initial+2, "Recovery was not observed"
    (args.output_dir / "result.json").write_text(json.dumps(report, indent=2))
    print(json.dumps(report, indent=2))
    raise SystemExit(1 if report["mismatch"] else 0)


if __name__ == "__main__":
    main()
