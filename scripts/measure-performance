#!/usr/bin/env python3
"""Read-only transport, PNG and agent timing; requires a running USB bridge.

Use the repository venv. This opens bounded RFB sessions, sends no phone input,
and does not change the server or production screenshot settings. PNG levels
are tested against one decoded frame, with exact pixel equality checked.
"""
import argparse
import asyncio
import base64
import hashlib
import io
import json
import os
from pathlib import Path
import statistics
import selectors
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from PIL import Image  # noqa: E402
from iphonebridge import control, transport  # noqa: E402


def summary(samples):
    ordered = sorted(samples)
    index = (len(ordered) - 1) * 0.95
    low = int(index)
    p95 = ordered[low] + (ordered[min(low + 1, len(ordered) - 1)] - ordered[low]) * (index - low)
    return {"samples": [round(x, 3) for x in samples],
            "median": round(statistics.median(samples), 3), "p95": round(p95, 3)}


def timed(fn):
    start = time.perf_counter()
    result = fn()
    return result, (time.perf_counter() - start) * 1000


def png_sweep():
    with control._session() as session:
        (png, size), capture_ms = timed(session.frame)
    with Image.open(io.BytesIO(png)) as opened:
        frame = opened.convert("RGB")
    pixels = frame.tobytes()
    if frame.convert("L").getextrema()[0] == frame.convert("L").getextrema()[1]:
        raise RuntimeError("Flat screen: unlock and display the intended workload")
    results = {level: {"encode_ms": [], "base64_and_json_ms": [], "decode_ms": [], "bytes": []}
               for level in (1, 2, 3, 6)}
    # Rotate the order to reduce warm-up/order effects, retaining one fixed image.
    for order in ((6, 1, 2, 3), (3, 2, 1, 6), (2, 6, 3, 1), (1, 3, 6, 2), (6, 2, 1, 3)):
        for level in order:
            def encode():
                out = io.BytesIO()
                frame.save(out, format="PNG", compress_level=level)
                return out.getvalue()
            encoded, encode_ms = timed(encode)
            _, serialize_ms = timed(lambda: json.dumps({"data": base64.b64encode(encoded).decode("ascii")}))
            def decode():
                with Image.open(io.BytesIO(encoded)) as candidate:
                    return candidate.convert("RGB").tobytes()
            decoded, decode_ms = timed(decode)
            assert decoded == pixels, "PNG settings changed pixels"
            entry = results[level]
            entry["encode_ms"].append(encode_ms)
            entry["base64_and_json_ms"].append(serialize_ms)
            entry["decode_ms"].append(decode_ms)
            entry["bytes"].append(len(encoded))
    return {"size": size, "initial_capture_ms": capture_ms,
            "pixel_sha256": hashlib.sha256(pixels).hexdigest(), "pixels_equal": True,
            "levels": {str(k): {name: summary(values) for name, values in entry.items()}
                       for k, entry in results.items()}}


def probes():
    cold, warm = [], []
    for _ in range(5):
        with control._session() as session:
            _, duration = timed(session.size)
            cold.append(duration)
            for _ in range(10):
                _, duration = timed(session.size)
                warm.append(duration)
    return {"cold_ms": summary(cold), "warm_ms": summary(warm)}


def captures():
    refresh, encode = [], []
    with control._session() as session:
        session.size()
        for _ in range(5):
            protocol, duration = timed(lambda: session.call("refreshScreen", incremental=False))
            refresh.append(duration)
            _, duration = timed(lambda: protocol.screen.save(io.BytesIO(), format="PNG"))
            encode.append(duration)
    return {"raw_refresh_and_image_assembly_ms": summary(refresh), "png_encode_ms": summary(encode)}


async def mcp_capture(command):
    from mcp.client.session import ClientSession
    from mcp.client.stdio import StdioServerParameters, stdio_client
    calls, decoding, sizes = [], [], []
    started = time.perf_counter()
    async with stdio_client(StdioServerParameters(command=command, args=["mcp"])) as (reader, writer):
        async with ClientSession(reader, writer) as client:
            await client.initialize()
            setup_ms = (time.perf_counter()-started)*1000
            for _ in range(5):
                started = time.perf_counter()
                result = await client.call_tool("screenshot", {})
                calls.append((time.perf_counter()-started)*1000)
                assert not result.is_error
                contents = [entry for entry in result.content if entry.type == "image"]
                assert len(contents) == 1
                metadata = result.structured_content
                def decode():
                    png = base64.b64decode(contents[0].data)
                    with Image.open(io.BytesIO(png)) as image:
                        image.load()
                        assert list(image.size) == [metadata["width"], metadata["height"]]
                    return len(png)
                size, duration = timed(decode)
                sizes.append(size)
                decoding.append(duration)
                path = Path(metadata["path"])
                # Only delete this call's newly generated screenshot.
                if metadata["action"] == "screenshot" and path.name.endswith("-screenshot.png"):
                    path.unlink()
    return {"server_start_and_initialize_ms": setup_ms, "tool_round_trip_ms": summary(calls),
            "client_png_decode_ms": summary(decoding), "png_bytes": sizes}


def usb(data_dir, cipher=None):
    state = json.loads((data_dir / "state.json").read_text())
    connection = state["connection"]
    # Use the existing owned USB listener; never open or close shared tunnels.
    args = [*transport.ssh_args(connection)]
    if cipher:
        args.extend(["-c", cipher])
    args.append(transport.PEER)
    setup, transfers = [], []
    for _ in range(3):
        _, duration = timed(lambda: subprocess.run([*args, "true"], check=True,
                                                   stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=10))
        setup.append(duration)
    for mib in (8, 32, 64):
        for _ in range(3):
            start = time.perf_counter()
            process = subprocess.Popen([*args, f"dd if=/dev/zero bs=1048576 count={mib} 2>/dev/null"],
                                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            first = None
            total = 0
            try:
                with selectors.DefaultSelector() as selector:
                    selector.register(process.stdout, selectors.EVENT_READ)
                    while True:
                        remaining = 20-(time.perf_counter()-start)
                        if remaining <= 0 or not selector.select(remaining):
                            raise TimeoutError("Transfer exceeded 20 seconds")
                        chunk = os.read(process.stdout.fileno(), min(65536, 65536-total) if total < 65536 else 65536)
                        if not chunk:
                            break
                        total += len(chunk)
                        if first is None and total >= 65536:
                            first = time.perf_counter()
                end = time.perf_counter()
                process.communicate(timeout=5)
                if process.returncode or total != mib * 1048576:
                    raise RuntimeError("SSH transfer failed or byte count differs")
                transfers.append({"bytes": total, "total_ms": (end-start)*1000,
                                  "first_64k_ms": (first-start)*1000,
                                  "total_MB_s": total/(end-start)/1e6,
                                  "after_first_64k_MB_s": (total-65536)/(end-first)/1e6})
            finally:
                if process.poll() is None:
                    process.terminate()
                    process.communicate(timeout=5)
    return {"setup_ms": summary(setup), "transfers": transfers,
            "units": "decimal MB/s; stream estimate excludes the first 64 KiB and its arrival time"}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=("probe", "png", "usb", "capture", "mcp"))
    parser.add_argument("--data-dir", type=Path, default=control.WORK,
                        help="Directory holding the saved USB state (default: the shared bridge data directory)")
    parser.add_argument("--command", default=str(ROOT / "bridge"), help="MCP launcher to measure")
    parser.add_argument("--cipher", choices=("aes128-gcm@openssh.com", "chacha20-poly1305@openssh.com"),
                        help="USB probe only; affects these diagnostic SSH sessions")
    parser.add_argument("--label", required=True)
    args = parser.parse_args()
    if args.cipher and args.mode != "usb":
        parser.error("--cipher applies only to the USB probe")
    report = {"label": args.label, "timestamp_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
              "input_sent": False, "mode": args.mode, "python": sys.version.split()[0]}
    if args.cipher:
        report["requested_cipher"] = args.cipher
    report["result"] = {"probe": probes, "png": png_sweep, "usb": lambda: usb(args.data_dir, args.cipher),
                        "capture": captures, "mcp": lambda: asyncio.run(mcp_capture(args.command))}[args.mode]()
    print(json.dumps(report, indent=2))


if __name__ == "__main__":
    main()
