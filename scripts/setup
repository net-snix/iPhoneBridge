#!/usr/bin/env python3
"""Prepare the locked native runtime and daemon without accessing the phone."""
import argparse
import json
from pathlib import Path
import runpy
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]


def run(*args, cwd=ROOT, capture=True):
    result = subprocess.run(args, cwd=cwd, check=True, capture_output=capture)
    return result.stdout if capture else b""


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def verified_manifest(root):
    manifest = json.loads((root / "work/build-manifest.json").read_text())
    project = json.loads((root / "dependency-lock.json").read_text())
    source_lock = json.loads((root / "device-sources.lock.json").read_text())
    verify = runpy.run_path(str(root / "scripts/stage-device-release"))["verify_build_provenance"]
    verify(manifest, project, source_lock, root)
    return manifest


def prepare(check_only=False, root=ROOT, build_options=()):
    try:
        manifest = verified_manifest(root)
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.CalledProcessError) as error:
        require(not check_only, f"No verified native source-built daemon: {error}; run scripts/setup")
        print(f"Rebuilding native daemon: {error}", file=sys.stderr)
        run(sys.executable, str(root / "scripts/build-device-deps"), *build_options,
            cwd=root, capture=False)
        # A successful process is insufficient; validate its artifact and all inputs again.
        manifest = verified_manifest(root)
    print(json.dumps(manifest, indent=2))
    return manifest


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Verify existing source and artifact without writes")
    parser.add_argument("--build-dir", type=Path)
    parser.add_argument("--theos", type=Path)
    parser.add_argument("--jobs", type=int, default=4)
    args = parser.parse_args()
    require(shutil.which("git") is not None, "git is required")
    require(args.jobs > 0, "--jobs must be positive")
    if not args.check:
        require(shutil.which("uv") is not None, "uv is required")
        run("uv", "sync", "--locked", capture=False)
    options = ["--jobs", str(args.jobs)]
    for name in ("build_dir", "theos"):
        value = getattr(args, name)
        if value is not None:
            options += ["--" + name.replace("_", "-"), str(value)]
    prepare(args.check, build_options=options)


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"setup: {error}", file=sys.stderr)
        sys.exit(1)
