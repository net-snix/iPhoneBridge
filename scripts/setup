#!/usr/bin/env python3
"""Prepare pinned local dependencies. Never installs or launches on the phone."""
import argparse
import hashlib
import json
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LOCK = json.loads((ROOT / "dependency-lock.json").read_text())
MANIFEST = ROOT / "work/build-manifest.json"


def run(*args, cwd=ROOT, capture=True):
    result = subprocess.run(args, cwd=cwd, check=True, capture_output=capture)
    return result.stdout if capture else b""


def git(path, *args):
    return run("git", "-C", str(path), *args).decode().strip()


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def checkout(spec, check_only):
    path = Path(spec["path"])
    if not path.exists():
        require(not check_only, f"Missing source checkout: {path}; run scripts/setup")
        path.parent.mkdir(parents=True, exist_ok=True)
        # New directories only. Never reset, clean, switch or pull an existing checkout.
        run("git", "clone", "--no-checkout", spec["url"], str(path), capture=False)
        run("git", "checkout", "--detach", spec["commit"], cwd=path, capture=False)
    require(git(path, "rev-parse", "HEAD") == spec["commit"], f"Unexpected HEAD: {path}")
    require(git(path, "rev-parse", "HEAD^{tree}") == spec["tree"], f"Unexpected source tree: {path}")
    require(not git(path, "ls-files", "--others", "--exclude-standard"), f"Untracked source files: {path}")
    return path


def source_digest(path):
    """Hash every tracked file plus its path; includes the local patch contents."""
    total = hashlib.sha256()
    for name in run("git", "ls-files", "-z", cwd=path).split(b"\0"):
        if name:
            total.update(name + b"\0")
            total.update(bytes.fromhex(digest(path / name.decode())))
    return total.hexdigest()


def prepare(check_only=False):
    spec = LOCK["trollvnc"]
    patch = ROOT / spec["patch"]
    require(digest(patch) == spec["patch_sha256"], "Patch changed; update reviewed dependency pin first")
    source = checkout(spec, check_only)
    diff = run("git", "diff", "--binary", "HEAD", cwd=source)
    if not diff:
        require(not check_only, "Reviewed TrollVNC patch is not applied; run scripts/setup")
        run("git", "apply", "--check", str(patch), cwd=source)
        run("git", "apply", str(patch), cwd=source)
        diff = run("git", "diff", "--binary", "HEAD", cwd=source)
    require(diff == patch.read_bytes(), "TrollVNC contains changes beyond the reviewed project patch")
    for relative, expected in spec["bundled_archives_sha256"].items():
        require(digest(source / relative) == expected, f"Bundled archive changed: {relative}")
    viewer = checkout(LOCK["novnc"], check_only)
    require(not git(viewer, "status", "--porcelain"), "noVNC checkout is dirty")
    theos = Path(LOCK["theos"]["path"])
    require(theos.is_dir(), f"Missing Theos at {theos}; install Theos and its {LOCK['theos']['sdk']} SDK")
    require(git(theos, "rev-parse", "HEAD") == LOCK["theos"]["commit"], "Theos HEAD differs from build pin")
    require(not git(theos, "diff", "HEAD", "--name-only"), "Theos tracked files have changed")
    sdk = theos / "sdks" / LOCK["theos"]["sdk"]
    require(sdk.is_dir(), f"Missing SDK: {sdk}; use Theos bin/install-sdk")
    source_sha = source_digest(source)
    binary = source / ".theos/obj/trollvncserver"
    prior = json.loads(MANIFEST.read_text()) if MANIFEST.exists() else {}
    known_build = binary.is_file() and (
        (digest(binary) == spec["existing_build_sha256"]
         and source_sha == spec["existing_build_source_sha256"]) or (
            prior.get("source", {}).get("files_sha256") == source_sha
            and prior.get("binary", {}).get("sha256") == digest(binary)
            and prior.get("build_command") == LOCK["build_command"]
            and prior.get("toolchain", {}).get("theos_commit") == LOCK["theos"]["commit"]
        )
    )
    if not known_build:
        require(not check_only, "No verified build artifact; run scripts/setup")
        # Invalidate only this build's CLI object output; no package/install/postinst targets.
        run(*LOCK["build_command"], "-B", cwd=source, capture=False)
    require(binary.is_file(), "Build did not produce the CLI artifact")
    manifest = {
        "schema_version": 1,
        "binary": {"path": str(binary), "sha256": digest(binary)},
        "source": {"path": str(source), "commit": spec["commit"], "tree": spec["tree"],
                   "files_sha256": source_sha, "patch": str(patch), "patch_sha256": digest(patch)},
        "bundled_archives_sha256": spec["bundled_archives_sha256"],
        "supply_chain": "Daemon compiled locally; bundled static archives supplied by pinned TrollVNC upstream, not source-rebuilt here.",
        "viewer": {"path": str(viewer), "commit": LOCK["novnc"]["commit"], "tree": LOCK["novnc"]["tree"]},
        "toolchain": {"theos_path": str(theos), "theos_commit": LOCK["theos"]["commit"],
                      "sdk_path": str(sdk), "xcode": run("xcodebuild", "-version").decode().strip()},
        "build_command": LOCK["build_command"],
    }
    if not check_only:
        MANIFEST.parent.mkdir(parents=True, exist_ok=True)
        temporary = MANIFEST.with_suffix(".tmp")
        temporary.write_text(json.dumps(manifest, indent=2) + "\n")
        temporary.replace(MANIFEST)
    print(json.dumps(manifest, indent=2))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Verify existing sources and artifact without writes")
    args = parser.parse_args()
    require(shutil.which("git") is not None, "git is required")
    if not args.check:
        require(shutil.which("uv") is not None, "uv is required")
        run("uv", "sync", "--locked", capture=False)
    prepare(args.check)


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, subprocess.CalledProcessError) as error:
        print(f"setup: {error}", file=sys.stderr)
        sys.exit(1)
