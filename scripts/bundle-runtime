#!/usr/bin/env python3
"""Assemble a relocatable runtime into an already-created macOS app bundle."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import runpy
import shutil
import site
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from iphonebridge import deployment
from iphonebridge.runtime import Paths, USB_TOOLS

APPLE_PREFIXES = ("/System/Library/", "/usr/lib/")
MACHO = {b"\xcf\xfa\xed\xfe", b"\xce\xfa\xed\xfe", b"\xca\xfe\xba\xbe",
         b"\xbe\xba\xfe\xca", b"\xca\xfe\xba\xbf"}


def run(*args):
    return subprocess.check_output(args, text=True).strip()


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def copy_tree(source, target):
    shutil.copytree(source, target, symlinks=True, ignore=shutil.ignore_patterns(
        "__pycache__", "*.pyc", ".DS_Store", ".git", "_virtualenv.py", "_virtualenv.pth"))


def dependencies(path):
    lines = run("/usr/bin/otool", "-arch", "arm64", "-L", str(path)).splitlines()[1:]
    deps = [line.strip().split(" (compatibility", 1)[0] for line in lines if line.startswith("\t")]
    # The first otool entry for a dylib is its install ID, not a loaded dependency.
    if path.name.endswith(".dylib"):
        deps = deps[1:]
    return deps


def is_macho(path):
    if not path.is_file() or path.is_symlink():
        return False
    with path.open("rb") as file:
        return file.read(4) in MACHO


def rpaths(path):
    lines = run("/usr/bin/otool", "-arch", "arm64", "-l", str(path)).splitlines()
    return [lines[index + 2].strip().removeprefix("path ").rsplit(" (offset", 1)[0]
            for index, line in enumerate(lines) if line.strip() == "cmd LC_RPATH"]


def copy_python(contents):
    base = Path(sys.base_prefix).resolve()
    if not (base / "lib" / f"libpython{sys.version_info.major}.{sys.version_info.minor}.dylib").exists():
        raise RuntimeError("Build with the uv-managed standalone CPython runtime in .venv")
    target = contents / "Resources/runtime/python"
    copy_tree(base, target)
    version = f"python{sys.version_info.major}.{sys.version_info.minor}"
    packages = target / "lib" / version / "site-packages"
    # Replace only this newly copied runtime's bootstrap packages with locked app packages.
    if packages.exists():
        shutil.rmtree(packages)
    candidates = [Path(value) for value in site.getsitepackages() if Path(value).is_dir()]
    if len(candidates) != 1 or candidates[0].is_relative_to(base):
        raise RuntimeError("Run bundle-runtime with the project's uv-synced .venv Python")
    copy_tree(candidates[0], packages)
    # uv also relocates CPython's generated sysconfig metadata to the build host.
    # Regenerate only that copied metadata with the actual runtime prefix.
    for metadata in (target / "lib" / version).glob("_sysconfigdata_*.py"):
        values = runpy.run_path(str(metadata))["build_time_vars"]
        lines = ["# Generated by iPhoneBridge's runtime packaging recipe.",
                 "from sys import base_prefix as _prefix", "build_time_vars = {"]
        for key, value in values.items():
            expression = repr(value)
            if isinstance(value, str) and str(base) in value:
                expression = repr(value.replace(str(base), "@PYTHON_PREFIX@"))
                expression += '.replace("@PYTHON_PREFIX@", _prefix)'
            lines.append(f"    {key!r}: {expression},")
        lines.extend(["}", "del _prefix", ""])
        metadata.write_text("\n".join(lines))
    # uv may write its host installation path into libpython's own loader ID.
    # Consumers already use @rpath; normalize the copied library for public bundles.
    library = target / "lib" / f"libpython{sys.version_info.major}.{sys.version_info.minor}.dylib"
    run("/usr/bin/install_name_tool", "-id", "@rpath/" + library.name, str(library))
    run("/usr/bin/codesign", "--force", "--sign", "-", str(library))
    # Some wheels retain inert CI build paths. Remove those from the copied binaries.
    for binary in target.rglob("*"):
        if not is_macho(binary):
            continue
        external = [value for value in rpaths(binary)
                    if value.startswith("/") and not value.startswith(APPLE_PREFIXES)]
        if external:
            changes = [item for value in external for item in ("-delete_rpath", value)]
            run("/usr/bin/install_name_tool", *changes, str(binary))
            run("/usr/bin/codesign", "--force", "--sign", "-", str(binary))
    return target, version


def copy_usb(contents):
    target = contents / "Helpers/usb"
    (target / "bin").mkdir(parents=True)
    (target / "lib").mkdir()
    queue = []
    for name in sorted(USB_TOOLS):
        original = shutil.which(name)
        if not original:
            raise RuntimeError(f"Missing build-host USB utility: {name}")
        queue.append((Path(original).resolve(), target / "bin" / name))
    copied = {}
    while queue:
        source, destination = queue.pop(0)
        if source in copied:
            continue
        if destination.exists():
            raise RuntimeError(f"USB library filename collision: {destination.name}")
        shutil.copy2(source, destination)
        copied[source] = destination
        for dependency in dependencies(source):
            if dependency.startswith(APPLE_PREFIXES):
                continue
            if not dependency.startswith("/"):
                raise RuntimeError(f"Unsupported build-host library reference: {dependency}")
            original = Path(dependency).resolve()
            queue.append((original, target / "lib" / original.name))
    for source, destination in copied.items():
        changes = []
        if destination.suffix == ".dylib":
            changes += ["-id", "@loader_path/" + destination.name]
        for dependency in dependencies(source):
            if dependency.startswith(APPLE_PREFIXES):
                continue
            relative = os.path.relpath(copied[Path(dependency).resolve()], destination.parent)
            changes += ["-change", dependency, "@loader_path/" + relative]
        if changes:
            run("/usr/bin/install_name_tool", *changes, str(destination))
            run("/usr/bin/codesign", "--force", "--sign", "-", str(destination))
    # Preserve the exact installed bottle recipe and receipt for binary provenance.
    records = {}
    notices = contents / "Resources/licenses/macOS-USB-build"
    for source in copied:
        parts = source.parts
        if "Cellar" not in parts:
            raise RuntimeError(f"USB provenance must come from a Homebrew cellar: {source}")
        index = parts.index("Cellar")
        formula, version = parts[index + 1:index + 3]
        prefix = Path(*parts[:index + 3])
        if formula not in records:
            destination = notices / formula
            destination.mkdir(parents=True)
            for candidate in prefix.iterdir():
                if candidate.is_file() and (candidate.name.startswith(("COPYING", "LICENSE", "AUTHORS"))
                                            or candidate.name in ("INSTALL_RECEIPT.json", "sbom.spdx.json")):
                    output = destination / candidate.name
                    if candidate.name == "INSTALL_RECEIPT.json":
                        receipt = json.loads(candidate.read_text())
                        receipt.get("source", {}).pop("path", None)
                        output.write_text(json.dumps(receipt, indent=2) + "\n")
                    else:
                        shutil.copy2(candidate, output)
            if (prefix / ".brew").exists():
                copy_tree(prefix / ".brew", destination / "formula")
            records[formula] = {"version": version, "files": []}
        records[formula]["files"].append({"path": str(copied[source].relative_to(contents)),
                                           "original_sha256": sha(source), "bundled_sha256": sha(copied[source])})
    return records


def audit_bundle(contents):
    binaries = []
    for path in contents.rglob("*"):
        if path.is_symlink() and not path.resolve().is_relative_to(contents):
            raise RuntimeError(f"External symlink in bundle: {path}")
        if not is_macho(path):
            continue
        device_binary = path.is_relative_to(contents / "Resources/device")
        if not device_binary:
            for value in rpaths(path):
                if value.startswith("/") and not value.startswith(APPLE_PREFIXES):
                    raise RuntimeError(f"External runtime search path in {path}: {value}")
        for dependency in dependencies(path):
            if dependency.startswith("/") and not dependency.startswith(APPLE_PREFIXES):
                raise RuntimeError(f"External binary dependency in {path}: {dependency}")
            if dependency.startswith("@loader_path/"):
                resolved = (path.parent / dependency.removeprefix("@loader_path/")).resolve()
                if not resolved.is_relative_to(contents) or not resolved.exists():
                    raise RuntimeError(f"Unresolved bundled dependency: {dependency}")
        binaries.append(str(path.relative_to(contents)))
    return binaries


def sign_macos_code(contents):
    """Sign concrete macOS files, without treating Python/Tcl folders as bundles."""
    signed = []
    for path in contents.rglob("*"):
        # The iOS daemon keeps its source-built signature, entitlements and manifest hash.
        # The native main executable is sealed with the enclosing app by build-app last.
        if (path.is_relative_to(contents / "Resources/device")
                or path.is_relative_to(contents / "MacOS") or not is_macho(path)):
            continue
        run("/usr/bin/codesign", "--force", "--sign", "-", str(path))
        run("/usr/bin/codesign", "--verify", "--strict", str(path))
        signed.append(str(path.relative_to(contents)))
    return signed


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("app", type=Path)
    parser.add_argument("--device-dir", type=Path, default=ROOT / "work/device-release")
    args = parser.parse_args()
    contents = args.app.resolve() / "Contents"
    if not contents.is_dir():
        raise RuntimeError("Create the app Contents directory before bundling")
    for path in (contents / "Resources/runtime/python", contents / "Helpers/usb", contents / "Resources/bridge"):
        if path.exists():
            raise RuntimeError(f"Runtime target already exists; use a fresh app build: {path}")
    bridge = contents / "Resources/bridge"
    bridge.mkdir(parents=True)
    for name in ("iphonebridge", "viewer", "fixtures"):
        copy_tree(ROOT / name, bridge / name)
    no_vnc = Paths.discover(ROOT).novnc
    lock = json.loads((ROOT / "dependency-lock.json").read_text())["novnc"]
    if run("git", "-C", str(no_vnc), "rev-parse", "HEAD") != lock["commit"]:
        raise RuntimeError("noVNC checkout does not match dependency-lock.json")
    if run("git", "-C", str(no_vnc), "status", "--porcelain", "--untracked-files=no"):
        raise RuntimeError("noVNC checkout has uncommitted tracked modifications")
    (bridge / "novnc").mkdir()
    for name in ("core", "vendor"):
        copy_tree(no_vnc / name, bridge / "novnc" / name)
    for name in ("LICENSE.txt", "AUTHORS"):
        shutil.copy2(no_vnc / name, bridge / "novnc" / name)
    device = contents / "Resources/device"
    copy_tree(args.device_dir.resolve(), device)
    _, _, manifest = deployment.artifacts(Paths.discover(bridge))
    licenses = contents / "Resources/licenses"
    copy_tree(ROOT / "licenses", licenses)
    shutil.copy2(ROOT / "THIRD_PARTY.md", licenses / "THIRD_PARTY.md")
    python, version = copy_python(contents)
    usb = copy_usb(contents)
    helper = contents / "Helpers/bridge"
    launcher = contents / "Resources/bridge-launcher"
    launcher.write_text('#!/bin/sh\nset -eu\n'
                      'CONTENTS="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"\n'
                      'exec "$CONTENTS/Resources/runtime/python/bin/' + version + '" -I -B '
                      '"$CONTENTS/Resources/bridge/iphonebridge/entry.py" "$@"\n')
    launcher.chmod(0o755)
    # Scripts belong in Resources; a relative symlink preserves the stable helper entrypoint.
    helper.symlink_to("../Resources/bridge-launcher")
    binaries = audit_bundle(contents)
    signed = sign_macos_code(contents)
    for record in usb.values():
        for item in record["files"]:
            item["bundled_sha256"] = sha(contents / item["path"])
    result = {"schema_version": 1, "python_version": sys.version.split()[0],
              "python_build": (python / "BUILD").read_text().strip(),
              "novnc_commit": lock["commit"], "device_sha256": manifest["binary"]["sha256"],
              "usb": usb, "audited_macho_files": binaries, "signed_macos_files": signed,
              "python_runtime": "Resources/runtime/python"}
    (contents / "Resources/runtime-manifest.json").write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps({"ok": True, "app": str(args.app.resolve()), "macho_files": len(binaries),
                      "python": result["python_version"], "usb_libraries": len(usb)}))


if __name__ == "__main__":
    main()
